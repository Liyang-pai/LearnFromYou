  <diagram id="interaction" name="04 课堂互动与结束">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1540" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="学生发言策略 &amp;amp; 正常结束课堂" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=32;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="32" width="1680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="认知更新、发言许可和声音开关分别控制；正常结束后才启动独立报告。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=16;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="91" width="1680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 当前工作区 ff1a4d3 · 2026-10-12  |  实线：流程 / 数据传递    虚线：反馈 / 说明    紫色：云端 LLM" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1486" width="1680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="speak" value="" style="rounded=1;arcSize=3;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1000" height="1260" as="geometry" />
        </mxCell>
        <mxCell id="speak-head" value="A  学生发言与教师打断" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#7AA5D6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="174" width="956" height="36" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="rounded=1;arcSize=3;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="1080" y="160" width="660" height="1260" as="geometry" />
        </mxCell>
        <mxCell id="end-head" value="B  正常结束与资源释放" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#64A69B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1102" y="174" width="616" height="36" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;取得最新候选发言&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;question / answer / ack / silence&lt;br&gt;附来源 ID、question_id、revision、addressed&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;依次检查 speech_block()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;① 学生未静音&lt;br&gt;② revision 仍匹配最新教师输入&lt;br&gt;③ 学习、审核、ASR 与教学片段已处理完&lt;br&gt;④ 教师当前未讲话&lt;br&gt;⑤ 达到点名 1 秒 / 非点名 5 秒停顿&lt;br&gt;⑥ 非 silence；未点名时只能提问&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="435" width="480" height="260" as="geometry" />
        </mxCell>
        <mxCell id="allowed" value="&lt;b&gt;现在允许发言？&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;shape=rhombus;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="755" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="hold" value="&lt;b&gt;暂时阻止 / 撤销候选&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;忙碌、教师讲话、停顿不足：等待&lt;br&gt;静音、过期、silence 或未点名的回答：丢弃&lt;br&gt;后台认知继续更新，不补播静音期间旧问题&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="deliver" value="&lt;b&gt;实际发送学生文字回复&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;记录 reply 与历史发言&lt;br&gt;只有真正问出才增加 attempts&lt;br&gt;第 1 次 asked；第 2 次 deferred&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="965" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tts" value="&lt;b&gt;语音播报开关开启？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;开启：macOS say / Windows System.Speech&lt;br&gt;关闭或声音失败：文字回复仍可查看&lt;br&gt;本机默认音频设备播报，可手动停止&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1175" width="480" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="candidate" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gate" target="allowed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="allowed" target="hold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="allowed" target="deliver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deliver" target="tts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="interrupt" value="&lt;b&gt;教师出现新语音 / 新文字&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;撤销旧候选；停止当前播报&lt;br&gt;新的内容回到输入 → 学习链路&lt;br&gt;教师继续讲授 / 解释 / 回答学生疑问&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/intake">
          <mxGeometry x="620" y="265" width="370" height="165" as="geometry" />
        </mxCell>
        <mxCell id="mute" value="&lt;b&gt;两个不同的开关&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;学生静音：禁止所有发言，但继续学习&lt;br&gt;语音播报：仅控制是否出声&lt;br&gt;关闭播报会停止当前声音&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="新输入使旧候选过期" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupt" target="candidate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="newlesson" value="&lt;b&gt;下一次试讲&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;重新创建课堂与初始状态&lt;br&gt;不继承上次认知或疑问&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="1180" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="end-click" value="&lt;b&gt;教师点击「结束试讲」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;浏览器停止上传并暂停麦克风&lt;br&gt;后端收到 end；进入受取消保护的收尾&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="235" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tail" value="&lt;b&gt;停止播报，排空音频与 ASR 尾段&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;不再接受新音频&lt;br&gt;VAD finish → 剩余短段识别&lt;br&gt;flush(session_end) 提交最后教学片段&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="425" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="drain" value="&lt;b&gt;等待审核与学习收尾&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;最长约 100 秒&lt;br&gt;若存在失败片段则停止等待&lt;br&gt;汇总尚未被学生处理的教师来源&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="630" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="finished" value="&lt;b&gt;保存并发送 finished&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;最终 StudentState、lesson、session_id&lt;br&gt;unprocessed_sources 明确标出未处理内容&lt;br&gt;本地课堂日志 logs/{sid}.jsonl&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="835" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;关闭课堂并释放 ASR 占用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;关闭认知任务、LLM 客户端、播报与日志&lt;br&gt;等待底层原生识别工作完成&lt;br&gt;清除活动课堂，再注册独立报告任务&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1040" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;启动课后报告服务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;浏览器正常结束后关闭，不取消已启动报告&lt;br&gt;报告详细生成路径见第 05 页&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/report">
          <mxGeometry x="1130" y="1260" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="end-click" target="tail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tail" target="drain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="drain" target="finished">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="finished" target="release">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="release" target="report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disconnect" value="&lt;b&gt;异常断线 / 服务关闭&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;释放课堂与 ASR 资源&lt;br&gt;没有正常 end 不自动生成报告&lt;br&gt;日志保留；报告任务中断时成功阶段可复用&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="970" width="370" height="160" as="geometry" />
        </mxCell>
