        <mxCell id="edge-10" value="汇总完整笔记" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="merge" target="final">
