            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="upload" target="pcm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vad" value="&lt;b&gt;重采样到 16 kHz + Silero VAD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;静音 0.6 秒结束短段；连续最长 12 秒&lt;br&gt;检测教师开口 → 取消候选并停止播报&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="445" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="asr" value="&lt;b&gt;本机 CPU ASR：asr_queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;选定 SenseVoice / Paraformer / Whisper&lt;br&gt;逐段最终转写；空结果跳过&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="625" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="text" value="&lt;b&gt;文字测试入口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;每次 ≤5000 字&lt;br&gt;直接形成教学片段&lt;br&gt;不改写文字；沿用课堂顺序&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="810" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="transcript" value="&lt;b&gt;登记教师来源 t1 / t2 / …&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;保存原文、输入来源、revision 和时间&lt;br&gt;展示短段转写；撤销旧候选发言&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="790" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pcm" target="vad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vad" target="asr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="asr" target="transcript">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="text" target="transcript">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aggregate" value="&lt;b&gt;聚合并提交教学片段&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;普通停顿 3 秒；&amp;gt;300 字后停顿 1 秒&lt;br&gt;点名停顿约 1 秒；稳定文本最长等 20 秒&lt;br&gt;文字立即提交；手动 / 上传结束 / 结束课堂也提交&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="970" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="transcript" target="aggregate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review-on" value="&lt;b&gt;本课开启审核？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;创建时确定，课堂中固定&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;shape=rhombus;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="1175" width="320" height="135" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="aggregate" target="review-on">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;串行 review_queue → 校正 LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;主题、知识点、术语表 + 最近 8 条教师来源&lt;br&gt;仅校正语音段；文字保持原值&lt;br&gt;不接收学生状态；保留口语与教师知识错误&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1025" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="review-out" value="&lt;b&gt;结果检查 / 失败回退&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;来源 ID、顺序与边界必须一致&lt;br&gt;审核总时限默认 15 秒（含结构修复）&lt;br&gt;失败 / 超时：采用原文并提示&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1240" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;teaching_queue：按序进入学生处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;采用文本 + 来源 ID；保留审计原文&lt;br&gt;学生只接收规范课堂文本，详见第 03 页&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/cognition">
          <mxGeometry x="640" y="1370" width="440" height="95" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="review-on" target="review">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="1242" />
              <mxPoint x="1110" y="1105" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="review" target="review-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="校正成功 / 原文回退" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="review-out" target="queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="否：原文直通" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="review-on" target="queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="controls" value="&lt;b&gt;上传与停止规则&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;上传前手动暂停麦克风并等待处理完成&lt;br&gt;上传时不混入麦克风或文字&lt;br&gt;停止：不再发送剩余数据，已接收与尾段继续处理&lt;br&gt;快速上传不模拟原始课堂的停顿时长&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="1035" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;音频异常&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;积压：停止收新音频，处理已接收内容&lt;br&gt;ASR 失败：本段无文本，提示重讲&lt;br&gt;断线不自动重传；音频不落盘、不上传云端&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="1280" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="&lt;b&gt;课前可选术语准备&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;主题与知识点 → 术语候选&lt;br&gt;默认总时限 30 秒；失败用主题与上下文&lt;br&gt;术语表仅供校正，不成为学生知识&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="270" width="520" height="165" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;审核记录与知识边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;调试台保留 raw_text / corrected_text&lt;br&gt;审核耗时与状态可追溯&lt;br&gt;teacher_source() 过滤原文等审计字段&lt;br&gt;引用存在 ≠ 校正或内容一定正确&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="530" width="520" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
