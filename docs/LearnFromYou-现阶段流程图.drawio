        <mxCell id="footer" value="LearnFromYou · 当前工作区 ff1a4d3 · 2026-10-12  |  实线：流程 / 数据传递    虚线：反馈 / 说明    紫色：云端 LLM" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1376" width="1660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="manage" value="" style="rounded=1;arcSize=3;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="800" height="1130" as="geometry" />
        </mxCell>
        <mxCell id="manage-head" value="A  模型准备 / 切换" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#7AA5D6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="174" width="756" height="36" as="geometry" />
        </mxCell>
        <mxCell id="debug" value="" style="rounded=1;arcSize=3;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="840" height="1130" as="geometry" />
        </mxCell>
        <mxCell id="debug-head" value="B  ASR 独立调试" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#79B79A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="902" y="174" width="796" height="36" as="geometry" />
        </mxCell>
        <mxCell id="list" value="&lt;b&gt;打开「ASR 模型」页面&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;GET /api/asr/models&lt;br&gt;显示已安装、已选择、下载与引擎状态&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="245" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="install" value="&lt;b&gt;选择固定清单中的模型并下载&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Paraformer / SenseVoice / Whisper Small / Turbo&lt;br&gt;下载对应权重、词表与 Silero VAD&lt;br&gt;可取消；校验文件大小与 SHA-256&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="425" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="select" value="&lt;b&gt;选择已完整安装的模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;保存本机 selected_id 配置&lt;br&gt;课堂或调试占用时禁止切换&lt;br&gt;选中不代表已加载推理引擎&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="645" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="acquire" value="&lt;b&gt;开始课堂 / 调试时 acquire()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;检查模型 + VAD；获得独占资源&lt;br&gt;本机 CPU 按需加载识别引擎&lt;br&gt;加载失败：清理占用、提示检查 / 重试&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="855" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;结束 / 断线 → release()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;等待原生推理完成并释放引擎&lt;br&gt;恢复空闲状态，可切换或重新测试&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1080" width="470" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="list" target="install">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="install" target="select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="select" target="acquire">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="acquire" target="release">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mnote" value="&lt;b&gt;运行条件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Python 3.11+ / 本机 HTTP 服务&lt;br&gt;LLM 密钥仅后端读取&lt;br&gt;本机 POST / WebSocket 检查来源&lt;br&gt;只允许一个活动试讲&lt;br&gt;课堂与 ASR 调试互斥&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="595" y="425" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;本地模型文件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;asr/models/ 被 Git 忽略&lt;br&gt;模型不随仓库分发&lt;br&gt;支持多个安装、单个选择&lt;br&gt;配置不含长期学生知识&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="595" y="830" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="dstart" value="&lt;b&gt;在课堂结束且资源空闲时开始&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;/ws/asr-debug&lt;br&gt;无需主题或 LLM 密钥&lt;br&gt;可选实时麦克风 / 浏览器解码音频文件&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="245" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dpcm" value="&lt;b&gt;发送 PCM 帧；获得本机引擎&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;上传逐帧等待 ACK；实时采集走队列&lt;br&gt;复用重采样、Silero VAD 与相同 ASR&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="455" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="dresult" value="&lt;b&gt;逐段显示识别结果与耗时&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;文本、音频时长、识别耗时&lt;br&gt;实时系数 RTF = 识别耗时 / 音频时长&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="665" width="490" height="125" as="geometry" />
        </mxCell>
        <mxCell id="dstop" value="&lt;b&gt;结束录音 / 完成或停止上传&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;不再发送新内容，处理已接收与末尾音频&lt;br&gt;汇总分段 / 字数 / 时长并释放资源&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="855" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="export" value="&lt;b&gt;清空 / 导出 JSON / 再次测试&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;结果由浏览器保存 / 导出&lt;br&gt;释放后可以换模型对比同一份录音&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="1080" width="490" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dstart" target="dpcm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dpcm" target="dresult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dresult" target="dstop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dstop" target="export">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dnote" value="&lt;b&gt;独立调试边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;不进入课堂认知&lt;br&gt;不调用 LLM 或 TTS&lt;br&gt;不做语音文字审核&lt;br&gt;不写课堂日志&lt;br&gt;不保存音频文件&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1455" y="455" width="220" height="220" as="geometry" />
        </mxCell>
