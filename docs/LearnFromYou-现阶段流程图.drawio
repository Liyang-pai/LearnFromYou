        <mxCell id="edge-5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validate" target="commit">
