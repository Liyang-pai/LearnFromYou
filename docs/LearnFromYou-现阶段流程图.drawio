              <mxPoint x="1170" y="797" />
              <mxPoint x="1170" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-8" value="用户重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="error" target="llm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="440" />
              <mxPoint x="1170" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="knowledge" value="&lt;b&gt;knowledge｜知识与纠正&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;tentative：初步认知；understood：课堂推断理解&lt;br&gt;unclear：缺少信息；conflict：冲突 / 失效&lt;br&gt;同 ID 修改：保存旧版本&lt;br&gt;supersedes：新条目替代旧条目并标记失效&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="525" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="questions" value="&lt;b&gt;open_questions｜疑问生命周期&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;pending → asked → resolved / deferred&lt;br&gt;按主题与文本去重；同一疑问最多问两次&lt;br&gt;resolved 必须有教师解释来源&lt;br&gt;已解决问题保留，不能换措辞重新激活&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="790" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;recent_events 与 knowledge_history&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;课堂事件：开场、任务、请求、结束、组织&lt;br&gt;只接受本轮教师来源；最多最近 20 条&lt;br&gt;历史：保存修订前知识、版本与替代 ID&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1035" width="450" height="155" as="geometry" />
