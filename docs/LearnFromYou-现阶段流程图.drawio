        <mxCell id="learn-head" value="学生学习主流程" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#7AA5D6;fontStyle=1;" vertex="1" parent="1">
