            <Array as="points">
              <mxPoint x="1250" y="454" />
              <mxPoint x="900" y="454" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pre-detail" value="&lt;b&gt;课前边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;新课堂不继承上次知识&lt;br&gt;主题与术语表不算已学知识&lt;br&gt;明确前置知识以 p 来源进入课堂&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/cognition">
          <mxGeometry x="50" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="intake-detail" value="&lt;b&gt;输入与顺序&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;音频只在本机处理&lt;br&gt;语音短段聚合后再学习&lt;br&gt;上传时输入互斥；文字绕过校正&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/intake">
          <mxGeometry x="400" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="state-detail" value="&lt;b&gt;认知的三类记录&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;知识：初步 / 推断理解 / 缺失 / 冲突&lt;br&gt;问题：待问 / 已问 / 解决 / 延期&lt;br&gt;事件：开场 / 任务 / 请求 / 结束&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/cognition">
          <mxGeometry x="750" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="speak-detail" value="&lt;b&gt;学生何时回应&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;先完成学习，再检查发言条件&lt;br&gt;点名约 1 秒；主动提问至少 5 秒&lt;br&gt;静音仍学习；新输入撤销旧候选&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/interaction">
          <mxGeometry x="1100" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="report-detail" value="&lt;b&gt;报告输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;讲授概括与四维短评&lt;br&gt;优先发现、保留做法、具体改法&lt;br&gt;1–3 分钟教师独立练习&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/report">
          <mxGeometry x="1450" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bounds" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="50" y="735" width="1700" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bounds-head" value="运行边界与当前范围" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="72" y="749" width="1656" height="36" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;浏览器 / 本机后端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;音频采集、解码、VAD、ASR、播报&lt;br&gt;课堂状态只在本次会话维护&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="810" width="510" height="125" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;云端 DeepSeek / 兼容 API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;接收课堂文本和必要上下文&lt;br&gt;承担课前范围、可选审核、学生、报告&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="645" y="810" width="510" height="125" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;b&gt;本地记录与阶段缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;logs/{sid}.jsonl 与报告 / 阶段 JSON&lt;br&gt;刷新读取缓存；不充当跨课长期记忆&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1215" y="810" width="510" height="125" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="当前是单活动课堂的开发调试界面。学生画像自动生成与确认尚未接入此工作区；已有画像图属于设计稿。无账号、多学生、视觉与长期记忆。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="1680" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="intake" name="02 教师输入与转写审核">
