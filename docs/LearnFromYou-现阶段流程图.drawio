        <mxCell id="title" value="LearnFromYou｜现阶段完整流程" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=32;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="32" width="1700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="从课前准备，到实时学习与互动，再到简明教学报告；各环节可进入后续详图。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=16;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="91" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 当前工作区 ff1a4d3 · 2026-10-12  |  实线：流程 / 数据传递    虚线：反馈 / 说明    紫色：云端 LLM" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1066" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;01 运行与模型准备&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;启动本机 FastAPI 服务&lt;br&gt;配置 LLM 密钥与本地 ASR&lt;br&gt;打开开发调试网页&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/models">
          <mxGeometry x="50" y="210" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;02 创建本次试讲&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;主题、知识点、前置知识、水平&lt;br&gt;加载 ASR · 整理课堂范围&lt;br&gt;可选准备转写审核术语表&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/cognition">
          <mxGeometry x="400" y="210" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;03 接收教师讲授&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;麦克风 / 上传音频 / 文字测试&lt;br&gt;本机 VAD + ASR → 教学片段&lt;br&gt;可选审核 → 顺序入队&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/intake">
          <mxGeometry x="750" y="210" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="student" value="&lt;b&gt;04 学习与课堂互动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;云端学生提出状态更新与回复&lt;br&gt;本机校验并提交认知状态&lt;br&gt;发言策略 → 文字 / 系统语音&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/interaction">
          <mxGeometry x="1100" y="210" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;05 结束与教学报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;处理尾段 · 保存最终状态&lt;br&gt;释放课堂与 ASR 资源&lt;br&gt;独立分析 → 查看 / 导出报告&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/report">
