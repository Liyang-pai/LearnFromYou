        <mxCell id="state-head" value="本机状态与异常处理" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1212" y="174" width="486" height="36" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="&lt;b&gt;课前 preparation LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;仅提取主题范围标签与边界说明&lt;br&gt;不展开定义、答案或未声明的前置知识&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="prereq" value="&lt;b&gt;明确前置知识：p 来源&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;只来自教师填写的 prerequisites&lt;br&gt;每次创建课堂重新开始&lt;br&gt;课题名、审核术语表均不等于已知内容&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="425" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;构建 payload / learning_context()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;本轮教师文本 + 必要教师来源&lt;br&gt;当前有效知识、失效知识与修订历史&lt;br&gt;问题 / 近期事件 + 最近 8 条学生发言&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="245" width="490" height="160" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;云端学生 LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;遵守核心学生规则与有限知识边界&lt;br&gt;结合课内证据进行有依据的推导&lt;br&gt;语义分类 + 状态更新 + 一个候选回复&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="475" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;结构与来源全部有效？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;JSON schema · 来源存在&lt;br&gt;纠正指向已知条目 · 问题 / 事件规则&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;shape=rhombus;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="710" width="370" height="175" as="geometry" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;原子提交本轮认知更新&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;全部通过才替换 StudentState&lt;br&gt;version +1，记录已处理教师来源&lt;br&gt;保存候选回复与目标 revision&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="965" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;候选进入发言策略&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;addressed：模型判断 / 本机点名检测&lt;br&gt;本轮学习完成不代表立即发言&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1" link="data:page/interaction">
          <mxGeometry x="610" y="1190" width="490" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="prereq" target="context">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
