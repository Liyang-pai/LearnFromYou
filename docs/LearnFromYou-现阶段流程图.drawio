              <mxPoint x="1180" y="1060" />
              <mxPoint x="1180" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-11" value="更新" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="commit" target="events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layer" value="&lt;b&gt;发送给学生的知识分层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;有效知识：tentative / understood&lt;br&gt;inactive_knowledge：unclear / conflict&lt;br&gt;历史单独提供，不能继续当有效规则&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;来源与推断限制&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;教师规范文本为 t 来源；前置为 p 来源&lt;br&gt;学生自身发言不能成为新知识来源&lt;br&gt;来源编号只证明引用存在，不证明语义正确&lt;br&gt;understood 不代表真实学生或永久掌握&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="950" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="下一轮读取" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="layer" target="context">
          <mxGeometry relative="1" as="geometry">
