          <mxGeometry x="1170" y="160" width="610" height="1320" as="geometry" />
        </mxCell>
        <mxCell id="c-head" value="云端：可选文字审核" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#A18AC9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="174" width="566" height="36" as="geometry" />
        </mxCell>
        <mxCell id="mic" value="&lt;b&gt;实时麦克风&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;授权真实麦克风&lt;br&gt;AudioWorklet / 兼容回退&lt;br&gt;单声道 Float32 PCM&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="210" height="140" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;上传音频文件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;WAV / MP3 / M4A&lt;br&gt;浏览器内存解码&lt;br&gt;≤700 MiB、≤60 分钟&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="310" y="250" width="210" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pcm" value="&lt;b&gt;校验音频帧并进入 audio_queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;采样率 8–96 kHz · 检查格式与数值&lt;br&gt;上传每帧 ≤2048 点，等 ACK 后继续&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mic" target="pcm">
