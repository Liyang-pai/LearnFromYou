          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="check" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="view" value="&lt;b&gt;前端只读恢复与导出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;GET /api/teaching-report/{sid} 轮询&lt;br&gt;URL 保存课堂编号；刷新恢复&lt;br&gt;结束到注册间最多约 30 秒只读等待&lt;br&gt;ready 时 GET /export 下载 Markdown&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="245" width="420" height="215" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;阶段失败 / 超时 / 服务中断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;标为 failed，保留课堂与已成功阶段&lt;br&gt;每阶段最多两次：仅格式 / 来源错误修正一次&lt;br&gt;单请求最长 60 秒；鉴权、额度、HTTP、截断&lt;br&gt;或超时不循环重试；用户点击重试才继续&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1300" width="420" height="235" as="geometry" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;用户看到四个部分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;① 总体概括 + 准确 / 清楚 / 连贯 / 师生互动&lt;br&gt;② 优先发现 + 一个值得保留的做法&lt;br&gt;③ 可直接使用的具体改法&lt;br&gt;④ 1–3 分钟教师独立练习与完成标准&lt;br&gt;页面与导出隐藏内部来源编号&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1300" y="245" width="460" height="235" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;评价范围&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;主要依据本次实际教师讲解&lt;br&gt;实际 AI 回应只作为辅助证据&lt;br&gt;不代表真实学生掌握；不输出评分或统计&lt;br&gt;无独立课后理解测试、两次试讲比较或自动评分&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1300" y="545" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="edge-13" value="完成后查看" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="view">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="1640" />
              <mxPoint x="560" y="510" />
              <mxPoint x="290" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="models" name="06 模型管理与独立调试">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1430" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="本地 ASR 模型管理 &amp;amp; 独立转文字测试" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=32;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="32" width="1660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="课堂与独立测试共享本机模型资源，互斥占用；已选模型只在使用时加载。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=16;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="91" width="1660" height="40" as="geometry" />
