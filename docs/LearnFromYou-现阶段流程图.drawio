        <mxCell id="pipeline-head" value="后台报告主流程" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#A18AC9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="602" y="174" width="596" height="36" as="geometry" />
        </mxCell>
        <mxCell id="long" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="1260" y="160" width="540" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="long-head" value="长课处理与输出" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1282" y="174" width="496" height="36" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;自动注册 / 手动生成 / 失败重试&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;POST /api/teaching-report/{sid}&lt;br&gt;正常结束自动触发；旧课堂可手动发起&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#79B79A;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="235" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;读取 finished 课堂并构建输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;校验课堂编号、正常结束、存在教师文本&lt;br&gt;按时间顺序保留审核后教师文字与实际 AI 回复&lt;br&gt;候选回复不入报告；未处理的教师文本仍保留&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="500" height="155" as="geometry" />
        </mxCell>
        <mxCell id="hit" value="&lt;b&gt;报告 ready / generating？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;同内容版本缓存 / 同进程活动任务&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;shape=rhombus;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="615" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="reuse" value="&lt;b&gt;复用已生成报告 / 返回生成进度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;同进程去重；不会开启第二次生成&lt;br&gt;缓存按输入、提示词、版本与 schema 哈希&lt;br&gt;损坏或中断结果需手动重试&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="595" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="register" value="&lt;b&gt;注册 generating 后台任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;服务内串行执行报告任务&lt;br&gt;一次实际执行预算 300 秒，排队不计&lt;br&gt;读取有效阶段缓存；仅重做未完成 / 损坏阶段&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="815" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="size" value="&lt;b&gt;精简输入 ≤24,000 字符？&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D7A85F;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;shape=rhombus;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="1015" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="short" value="&lt;b&gt;短课：直接完整分析&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;一次报告阶段，保留全课前后关系&lt;br&gt;结合解释、更正、延期与实际回应&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1020" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="&lt;b&gt;长课：顺序分段分析&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;单段目标 ≤12,000 字符&lt;br&gt;长发言按句或固定长度拆分，保留原 ID&lt;br&gt;每段保存要点、解释、更正、延期与候选问题&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1300" y="865" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;笔记过长：继续顺序归并&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;逐级保留来源、范围与语义关系&lt;br&gt;完整覆盖全部段落后统一判断&lt;br&gt;不将早期缺失候选直接当全课问题&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1095" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;形成最终 TeachingReport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;核对后续解释、更正、总结与合理延期&lt;br&gt;全课仅保留一个优先改进方向&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=#A18AC9;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1230" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;校验报告结构、来源与长度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;JSON / 教师来源 / 四维与整体一致性&lt;br&gt;正文目标 250–350 字，硬上限 400 字符&lt;br&gt;练习完成标准评价教师动作&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7AA5D6;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1410" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;ready → 原子保存报告缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;logs/{sid}.teaching-report-v2.json&lt;br&gt;全部阶段完成才可 ready / 导出&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3F0;strokeColor=#64A69B;strokeWidth=1.5;fontColor=#17324D;fontFamily=Helvetica;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1590" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="request" target="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="read" target="hit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#60758B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hit" target="reuse">
