        <mxCell id="n21" value="running / stale / completed / failed；后两者含 state，failed 带可重试提示。" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=PingFang SC;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CAED8;strokeWidth=1;fontSize=17;" vertex="1" parent="1">
