        <mxCell id="n13" value="ready 含课堂、范围、画像基础、state 等；status 主要是运行提示，不是知识状态。" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=PingFang SC;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CAED8;strokeWidth=1;fontSize=17;" vertex="1" parent="1">
