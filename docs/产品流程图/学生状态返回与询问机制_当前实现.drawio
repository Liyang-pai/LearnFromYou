        <mxCell id="n23" value="finished 保存结束快照；error 提示失败；llm_* 留请求与原始输出，不代表状态已接受。" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=15;fontFamily=PingFang SC;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#B8C5D2;strokeWidth=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="965" width="920" height="65" />
