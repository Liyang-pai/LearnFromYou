          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="missing" target="eligible">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eligible" target="unavailable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eligible" target="start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="用户点击重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="failed" target="eligible">
          <mxGeometry relative="1" as="geometry" />
