  <diagram id="p5" name="05 按实际请求整合讲授批次">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1420">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="历史讲授 · 按实际请求批次整合" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="只整理已有日志，不修改实时发送逻辑，不重新调用模型。请求发起不代表处理成功；批次正文逐段使用当时实际提交的文本。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#9ca3af;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="1480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="read" value="后台逐行读取原始日志" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="收集原始转写&#10;保留片段、原文与发生时间&#10;审核记录只更新未确认片段的展示文本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="batch" value="提取 student 请求中的 new_teacher_segments&#10;支持普通文本和带图片请求中的文本部分&#10;忽略系统提示词、旧上下文及恢复发言请求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="370" width="850" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dedup" value="来源、顺序和文本完全一致的重复请求 → 合并&#10;保留首次请求的位置与时间；正文不润色、不补写&#10;请求批次可包含多个队列教学片段" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="550" width="850" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state" value="匹配处理结果&#10;state 记录成功处理；model_failure 记录失败&#10;只有请求但缺少成功记录时，不宣称已成功处理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#c69a45;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="730" width="850" height="110" as="geometry" />
        </mxCell>
        <mxCell id="unknown" value="没有可确认请求批次的原始片段&#10;保留原位置与文字&#10;标注“发送批次未确认”，不猜测合并" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#c69a45;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="710" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="order" value="合成历史时间线&#10;老师批次按首次请求事件排列&#10;学生回复保持实际发言顺序&#10;每批讲授不强行配一个学生回答" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="925" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="写入版本 2 的摘要及分页对话缓存&#10;旧缓存自动重建；每页最多 50 条展示消息&#10;讲授批次不跨页拆分，原始日志与报告不变" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f5ed;strokeColor=#5c9c76;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="1110" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="页面展示&#10;正文为实际提交文本；展开原始转写&#10;失败、未确认发送和缺失原文均明确提示" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f5ed;strokeColor=#5c9c76;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="1270" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="transcript" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="read" target="raw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="student 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="read" target="batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="batch" target="dedup">
          <mxGeometry relative="1" as="geometry" />
