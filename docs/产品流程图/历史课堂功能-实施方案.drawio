        </mxCell>
        <mxCell id="e19" value="生成中" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="working">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="缺失" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="missing">
