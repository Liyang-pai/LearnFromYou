        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="checkpoint" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="end" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="否 / 断连 / 服务退出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="end" target="interrupt">
