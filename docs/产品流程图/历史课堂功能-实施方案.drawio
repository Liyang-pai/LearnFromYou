        <mxCell id="e18" value="有效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="ready">
