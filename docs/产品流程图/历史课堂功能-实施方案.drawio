  <diagram id="p4" name="04 缺失报告自动生成">
    <mxGraphModel dx="1600" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="历史课堂 · 缺失报告自动生成（拟新增）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="报告独立缓存，不以课堂日志里是否包含报告作为判断依据。自动补生成会调用模型；画像、对话和导出日志可先正常使用。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#9ca3af;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="1480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="open" value="用户打开历史课堂详情" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="235" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="check" value="读取并检查对应课堂的报告缓存与任务&#10;复用现有报告状态查询接口&#10;已失效缓存按“缺失”处理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="365" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="已有有效报告&#10;直接展示，结束本次检查" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f5ed;strokeColor=#5c9c76;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="working" value="已有生成任务&#10;复用任务并显示进度" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="missing" value="没有有效报告&#10;检查生成条件" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="failed" value="上次生成失败或中断&#10;显示原因和“重试”按钮&#10;不因刷新页面无限自动重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#c69a45;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="540" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eligible" value="是否正常结束，且有教师讲授内容&#10;并能被现有报告读取器有效解析？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#c69a45;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="725" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="unavailable" value="条件不满足&#10;未正常结束：暂不能生成报告&#10;无讲授或材料不可读：说明原因&#10;其他已保存内容仍可查看" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#9ca3af;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="725" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="start" value="首次缺失则自动请求生成&#10;复用现有报告生成接口&#10;同一课堂重复请求共用生成任务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="915" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="progress" value="展示生成进度并轮询报告状态&#10;切换页面不取消后台任务&#10;再次打开时继续查询同一任务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="1085" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="result" value="本次生成结果" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#5b82c4;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="1250" width="320" height="85" as="geometry" />
        </mxCell>
        <mxCell id="saved" value="成功：保存报告缓存并展示&#10;下次打开直接读取" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f5ed;strokeColor=#5c9c76;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1410" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="error" value="失败：展示原因与重试按钮&#10;用户点击后重新检查条件并发起生成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#c69a45;fontFamily=Helvetica;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="1410" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="open" target="check">
