<mxfile host="Electron" page="3" pages="4">
  <diagram id="1" name="01 功能流程">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2270" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="LearnFromYou｜学生画像实时分析" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="课前独立生成一次 → 教师确认 → 注入学生上下文 → 课堂更新认知状态" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="1280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="① 课前：生成并确认初始画像" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="75" y="140" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="② 课堂：按画像听讲与提问" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="860" y="140" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="start" value="用户准备开始试讲" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="input" value="填写教学主题（唯一必填）&#xa;填写后即可点击 AI 生成&#xa;年级、学科等信息均可选填" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="optional" value="可选：年级、学科、准备讲的知识点&#xa;学生水平默认普通；课型默认新课&#xa;更多：教材；学生基础合并到画像" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="420" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="generate" value="点击「生成学生画像」&#xa;首次生成 / 再次生成均走此入口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="550" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="独立调用 DeepSeek 画像生成器&#xa;生成画像；补全年级、学科&#xa;准备讲的知识点未填时一并生成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1005.0" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="调用成功且&#xa;JSON 字段有效？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff6df;strokeColor=#cca85b;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;shape=rhombus;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="175" y="1140.0" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="error" value="生成或校验失败&#xa;保留全部输入和现有画像 Prompt&#xa;不清空准备讲的知识点；允许重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff6df;strokeColor=#cca85b;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="495" y="1145.0" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="preview" value="展示「学生画像」及教学设置&#xa;合并原「学生已经知道什么」「理解基础」&#xa;单独展示可编辑的「准备讲的知识点」" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1440.0" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="教师确认画像？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff6df;strokeColor=#cca85b;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;shape=rhombus;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="175" y="1600.0" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edit" value="修改学生画像或教学设置&#xa;保留「准备讲的知识点」独立字段&#xa;再次生成回到覆盖确认入口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="495" y="1605.0" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="save" value="非空检查通过后创建试讲&#xa;保存本次学生设定与教学范围&#xa;据此初始化课堂动态认知状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="2040" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="构建 AI 学生上下文&#xa;核心行为规则 + 已确认学生画像&#xa;准备讲的知识点仅表示教学范围&#xa;+ 当前认知状态 + 课堂对话" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="875" y="210" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="talk" value="教师讲话&#xa;作为 User 消息进入课堂历史" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="875" y="365" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="student" value="调用 AI 学生模型&#xa;依据画像、课堂证据与当前状态&#xa;判断理解障碍、矛盾及合理迁移" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="875" y="495" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="reaction" value="按现有交互规则输出&#xa;提问 / 回应 / 不发言&#xa;不因模型知道答案就默认学生懂了" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="875" y="645" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="state" value="由现有状态机制更新课堂认知&#xa;记录已讲内容、理解程度及待解疑问&#xa;不重新生成初始画像" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="875" y="795" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="endcheck" value="结束试讲？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff6df;strokeColor=#cca85b;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;shape=rhombus;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="945" y="960" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="end" value="保存课堂记录及最终认知状态&#xa;进入现有课后报告流程" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="875" y="1115" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="note" value="回填规则&#xa;• 用户已填设置优先，AI 不得覆盖。&#xa;• 准备讲的知识点未填时由 AI 生成。&#xa;• 画像有内容时再次生成，先确认覆盖。&#xa;• 取消或失败，保留所有现有内容。&#xa;• 学生设定 Prompt 为空或仅空白，禁止创建。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
