  <diagram id="2" name="02 Prompt 与状态关系">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Prompt 与状态关系｜两种调用，互不混用上下文" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a" value="画像生成调用（课前一次）" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="65" y="125" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b" value="学生对话调用（课堂多次）" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="675" y="125" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="genrules" value="画像生成 System&#xa;用户已填信息为约束，不得覆盖&#xa;知识点未填时生成教学范围&#xa;本课待讲内容不能视作已掌握" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="geninput" value="画像生成 User&#xa;教学主题 + 用户已填教学设置&#xa;准备讲的知识点：有则使用，无则生成&#xa;原已知知识与理解基础合并到画像" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="355" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="json" value="生成候选结果 → 校验 → 成功回填&#xa;准备讲的知识点：保留用户填写内容&#xa;学生画像：已有内容先确认再替换" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="515" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fixed" value="确认后的学生画像（课堂内固定）&#xa;已有知识、理解基础及认知边界" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="390" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sys" value="学生 System&#xa;① 既有行为及知识边界规则&#xa;② 确认后的学生画像&#xa;③ 准备讲的知识点：仅作教学范围&#xa;待讲知识不能提前进入已知状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="695" y="205" width="400" height="165" as="geometry" />
        </mxCell>
        <mxCell id="dynamic" value="课堂动态状态（随课堂更新）&#xa;已讲知识、理解程度、未解决疑问&#xa;作为现有系统的受控上下文传入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7ef;strokeColor=#70a782;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="695" y="415" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="history" value="课堂对话历史&#xa;User：教师讲话&#xa;Assistant：学生已有回复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#6998d1;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="695" y="585" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="request" value="合并为本轮学生 API 请求&#xa;由现有状态机制维护动态状态&#xa;继续下一轮课堂" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="695" y="745" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=1.5;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="genrules" target="geninput">
