          <mxGeometry x="495" y="815" width="285" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="组装生成输入（用户填写优先）&#xa;准备讲的知识点已填：作为约束保留&#xa;年级、学科为空：交给 AI 推断&#xa;其他未填设置使用既定默认值" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1ecfc;strokeColor=#9a83c5;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
