          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="画像 Prompt 只要已有内容，再次生成就提示覆盖；准备讲的知识点保留为独立字段，用户填写时不得覆盖。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="60" y="885" width="1090" height="60" as="geometry" />
