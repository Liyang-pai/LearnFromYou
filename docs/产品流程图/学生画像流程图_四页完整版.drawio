  <diagram id="3" name="03 界面字段与覆盖规则">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="界面调整｜保留教学范围，合并学生基础" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#24334b;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="45" y="30" width="1020" height="55" as="geometry" />
        </mxCell>
        <mxCell id="old" value="现有四项&#xa;① 教学主题&#xa;② 准备讲的知识点&#xa;③ 学生已经知道什么&#xa;④ 理解基础" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="385" height="175" as="geometry" />
        </mxCell>
        <mxCell id="new" value="调整后的三项&#xa;① 教学主题（必填）&#xa;② 准备讲的知识点（选填，独立保留）&#xa;③ 学生画像（可生成、可编辑）&#xa;   包含已有知识与理解基础" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="610" y="125" width="420" height="175" as="geometry" />
        </mxCell>
        <mxCell id="mapping" value="下面两项合并" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=1.5;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="old" target="new">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="knowledge" value="准备讲的知识点｜生成与保留规则&#xa;用户填写 / 修改：作为生成约束，AI 不覆盖&#xa;用户未填写：AI 根据教学主题生成并回填&#xa;表示本次待讲范围，不代表学生已经学会" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="365" width="960" height="130" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="学生画像｜替换规则&#xa;原「学生已经知道什么」与「理解基础」合并到此&#xa;画像 Prompt 已有内容：再次生成前提示是否放弃更改&#xa;取消：保留原内容；确认：成功后替换，失败仍保留" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="545" width="960" height="140" as="geometry" />
        </mxCell>
        <mxCell id="migration" value="已有配置迁移&#xa;保留教学主题和准备讲的知识点&#xa;将旧「学生已经知道什么」「理解基础」合并到画像&#xa;不静默丢弃用户已填写的旧配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="735" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="creation_rule" value="创建试讲校验&#xa;学生设定 Prompt 为空或仅含空白字符：阻止创建，不创建课堂会话&#xa;提示：请先生成或填写学生设定，再创建试讲。&#xa;保留现有输入；用户生成或手动补全后，可再次创建" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#94a3b8;fontColor=#24334b;fontSize=16;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="900" width="960" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
