<mxfile host="Electron" agent="Codex" compressed="false" pages="5">
  <diagram id="mechanism" name="01｜为什么有认知状态，却没有声音？">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#52657D;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="01｜为什么有认知状态，却没有声音？" vertex="1">
          <mxGeometry height="55" width="1480" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="2026-10-14 · 三套机制彼此独立：有障碍 ≠ 已登记疑问；有候选回复 ≠ 实际已经发言。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;这次的主要原因：同题问了两次后，第三次追问被旧逻辑清空&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;最新课堂 bd6548196688：两次追问 → deferred（暂缓）→ 教师再次询问 → 模型想问第三次 → 程序改成 silence。&lt;br&gt;日志未包含第二次修复的提示词，运行行为也仍是旧逻辑。&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="1480" x="60" y="175" as="geometry" />
        </mxCell>
        <mxCell id="knowledge" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;知识状态｜我理解了什么？&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;understood / tentative / unclear / conflict / invalid&lt;br&gt;限制哪些内容能作为推理前提。&lt;br&gt;它不直接决定是否开口。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="460" x="60" y="350" as="geometry" />
        </mxCell>
        <mxCell id="questions" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;问题状态｜这个疑问问过几次？&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;pending → asked → deferred / resolved&lt;br&gt;两次实际追问后，问题暂缓。&lt;br&gt;暂缓表示不再主动重复，不表示已理解。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="460" x="570" y="350" as="geometry" />
        </mxCell>
        <mxCell id="speech" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;发言控制｜这句话现在能发吗？&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;点名、静音、停顿、输入是否已变化。&lt;br&gt;再检查候选所用知识是否仍可用。&lt;br&gt;允许后才显示文字并启动播报。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="460" x="1080" y="350" as="geometry" />
        </mxCell>
        <mxCell id="pipeline" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="实际发言链路｜任一阶段都可能没有声音" vertex="1">
          <mxGeometry height="45" width="1480" x="60" y="550" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;教师输入&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;课堂文字或语音转写&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="60" y="615" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;模型提出候选&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;answer / ack / question / silence&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="340" y="615" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;程序校验与限制&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;关联、知识前提、提问次数&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="660" y="615" as="geometry" />
        </mxCell>
        <mxCell id="gate" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;发言时机检查&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;静音 / 过期 / 忙碌 / 停顿&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="980" y="615" as="geometry" />
        </mxCell>
        <mxCell id="delivery" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;真正发出&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;reply → 文字 → 语音&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="1300" y="615" as="geometry" />
        </mxCell>
        <mxCell id="flow_input" edge="1" parent="1" source="input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="model" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_model" edge="1" parent="1" source="model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="validate" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_validate" edge="1" parent="1" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="gate" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_gate" edge="1" parent="1" source="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="delivery" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;A｜模型主动沉默&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;原始输出就是 silence。&lt;br&gt;常见原因：已暂缓、不认为被点名。&lt;br&gt;此时没有回复可供播放。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="60" y="800" as="geometry" />
        </mxCell>
        <mxCell id="b" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;B｜次数规则拦截&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;原始 question → 提交 silence。&lt;br&gt;第三次同题追问被清空。&lt;br&gt;这是改造前就有的机制。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="440" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;C｜知识前提拦截&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;引用了 conflict / unclear / invalid&lt;br&gt;或待复核知识，回复被限制。&lt;br&gt;需区分“描述冲突”和“采用前提”。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="820" y="800" as="geometry" />
        </mxCell>
        <mxCell id="d" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;D｜时机或播放问题&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;等待停顿、静音、新输入取消旧回复。&lt;br&gt;只有已经有 reply 但没有声音，&lt;br&gt;才继续查语音播报。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="1200" y="800" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="阅读顺序：第 2 页看历史日志断点 → 第 3 页看修理方案 → 第 4 页看历史与验收 → 第 5 页看本次例外放行设计。&lt;br&gt;note 不是已发言凭据，实际看 reply；新增方案已实现；本次验收见同目录《发言机制验收记录》。" vertex="1">
          <mxGeometry height="95" width="1480" x="60" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="latest-log" name="02｜最新日志：前期能说，后期在哪里断了？">
    <mxGraphModel dx="2074" dy="1195" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1240" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#52657D;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="02｜最新日志：前期能说，后期在哪里断了？" vertex="1">
          <mxGeometry height="55" width="1480" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="证据：logs/bd6548196688.jsonl · 上海时间 11:15—11:20 · 左侧是实际过程，右侧解释原因。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;11:17:50 · t5｜首次提出自转疑问&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;模型生成 question；程序保留；日志中出现 reply。&lt;br&gt;问题 q_rotation_unfelt 从 pending 变为 asked，次数 = 1。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="950" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="t5_why" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;正常发言&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;语音已完成播报，证明当时文字与语音链路可以正常工作。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="460" x="1080" y="190" as="geometry" />
        </mxCell>
        <mxCell id="t5_reason" edge="1" parent="1" source="t5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t5_why" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;11:18:22 · t6｜再次解释“高速会甩出去”&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;学生追加一次澄清；再次出现 reply。&lt;br&gt;第二次真正发出后：attempts = 2，问题变为 deferred。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="950" x="60" y="360" as="geometry" />
        </mxCell>
        <mxCell id="t6_why" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;限制开始生效&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;次数由实际发言累加。deferred 的含义是暂缓重复追问，而不是学生已经理解。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="460" x="1080" y="360" as="geometry" />
        </mxCell>
        <mxCell id="t6_reason" edge="1" parent="1" source="t6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t6_why" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6_next" edge="1" parent="1" source="t5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="t6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;11:19:09 · t7｜继续举摩托车的例子&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;原始模型输出：addressed=false，candidate=silence。&lt;br&gt;模型备注：疑问已 deferred，不重复追问。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="950" x="60" y="530" as="geometry" />
        </mxCell>
        <mxCell id="t7_why" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;断点 A1｜模型自己沉默&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;回复没有被程序删掉；模型根本没有生成发言。这是“暂缓 + 未被点名”的结果。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="460" x="1080" y="530" as="geometry" />
        </mxCell>
        <mxCell id="t7_reason" edge="1" parent="1" source="t7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t7_why" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7_next" edge="1" parent="1" source="t6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="t7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;11:19:43 · t9｜“同学，有什么问题吗”&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;原始输出：addressed=true，question，仍引用旧问题。&lt;br&gt;程序提交：silence；没有 reply；显示“本轮无需发言”。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="950" x="60" y="700" as="geometry" />
        </mxCell>
        <mxCell id="t9_why" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;断点 B｜程序拦掉第三次追问&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;模型知道被询问，却又想问同一问题。旧规则不把它改为简短回应，而是直接清空。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="460" x="1080" y="700" as="geometry" />
        </mxCell>
        <mxCell id="t9_reason" edge="1" parent="1" source="t9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t9_why" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t9_next" edge="1" parent="1" source="t7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="t9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;11:19:59 · t10｜“貌似又听不到你说话”&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;原始输出：addressed=false，candidate=silence。&lt;br&gt;模型把这句当作描述，认为没有新知识，不重复追问。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="950" x="60" y="870" as="geometry" />
        </mxCell>
        <mxCell id="t10_why" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;断点 A2｜回应意图没被识别&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;“反馈听不到声音”没有被识别成要求回应。需要单独处理回应请求，不能只依赖提问次数。&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="460" x="1080" y="870" as="geometry" />
        </mxCell>
        <mxCell id="t10_reason" edge="1" parent="1" source="t10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t10_why" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t10_next" edge="1" parent="1" source="t9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="t10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="runtime" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;运行版本的证据｜这轮加载了第一次修复，但没加载第二次修复&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;每次模型请求都有“可以描述冲突”的补丁；却没有“deferred 只限制主动重复追问，不限制回应教师”的补丁。&lt;br&gt;t9 的处理也是旧规则：第三次 question 直接变 silence，没有进入新修复流程。具体是旧进程还是另一份服务，日志无法确定。&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="1480" x="60" y="1070" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="targeted-repair" name="03｜每个断点的针对性修理方式">
    <mxGraphModel dx="2111" dy="1216" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1320" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#52657D;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="03｜每个断点的针对性修理方式" vertex="1">
          <mxGeometry height="55" width="1480" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="蓝色＝已实现；橙色＝运行与验收。方案已实施，模型/浏览器/离线验收见同目录记录；声音听感另行确认。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="cause-label" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="为什么没有话" vertex="1">
          <mxGeometry height="40" width="430" x="60" y="165" as="geometry" />
        </mxCell>
        <mxCell id="repair-label" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="针对性修理" vertex="1">
          <mxGeometry height="40" width="590" x="550" y="165" as="geometry" />
        </mxCell>
        <mxCell id="verify-label" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="如何证明修好" vertex="1">
          <mxGeometry height="40" width="340" x="1200" y="165" as="geometry" />
        </mxCell>
        <mxCell id="repeat_c" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;B｜暂缓疑问遇到教师再次询问&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;历史断点：第三次 question 被清空。&lt;br&gt;旧补丁改为 answer / ack，未保留提问功能。&lt;br&gt;新方案：疑问仍用 question，另申请例外放行。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="430" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="repeat_r" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;已实现｜两次常规上限 + 例外申请&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;模型须自觉遵守：同一疑问通常最多问两次。&lt;br&gt;教师明确询问疑问时：question + 放行请求。&lt;br&gt;请求关联原问题 ID、教师来源及申请理由。&lt;br&gt;程序校验后仅放行本次；不改成 answer / ack。&lt;br&gt;不重置额度、不换 ID；详细流程见第 5 页。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="590" x="550" y="220" as="geometry" />
        </mxCell>
        <mxCell id="repeat_v" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;验收条件&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;无明确邀请：第三次不主动问；&lt;br&gt;有邀请 + 有效请求：发出 question；&lt;br&gt;每次邀请最多放行一次；&lt;br&gt;发出才计数，原问题仍暂缓。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1200" y="220" as="geometry" />
        </mxCell>
        <mxCell id="repeat_e1" edge="1" parent="1" source="repeat_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="repeat_r" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="repeat_e2" edge="1" parent="1" source="repeat_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="repeat_v" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="premise_c" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;C｜描述困惑被当作采用冲突前提&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;knowledge_ids 填了冲突双方，&lt;br&gt;程序以为学生用它们推导确定答案。&lt;br&gt;这是最初那次日志的原因。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="430" x="60" y="470" as="geometry" />
        </mxCell>
        <mxCell id="premise_r" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;已有补丁｜区分“提到说法”和“用它推导”&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;仅描述矛盾：保留 sources，knowledge_ids 不列冲突双方。&lt;br&gt;确实依赖不可用知识作答：改为说明障碍。&lt;br&gt;误填时反馈模型修正；不直接删前提放行确定答案。&lt;br&gt;最终仍失败：明示跳过原因，保留有效学习记录。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="590" x="550" y="470" as="geometry" />
        </mxCell>
        <mxCell id="premise_v" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;验收条件&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;“我不明白”可以发出；&lt;br&gt;冲突知识仍不能推导确定答案；&lt;br&gt;无效知识更新不能被放过。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1200" y="470" as="geometry" />
        </mxCell>
        <mxCell id="premise_e1" edge="1" parent="1" source="premise_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="premise_r" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="premise_e2" edge="1" parent="1" source="premise_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="premise_v" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="intent_c" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;A2｜回应请求被当作描述&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;例如“听不到你说话”。&lt;br&gt;原始输出就是 silence，&lt;br&gt;现有补丁未覆盖所有这类情况。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="430" x="60" y="720" as="geometry" />
        </mxCell>
        <mxCell id="intent_r" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;已实现｜区分教师的回应意图&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;询问疑问 / 要求回答 / 检查声音 / 继续讲授分开。&lt;br&gt;明确询问疑问：有疑问用 question，暂缓项须申请。&lt;br&gt;回答具体题目用 answer；检查声音可用 ack。&lt;br&gt;“懂吗 / 在吗”不自动授权重问暂缓疑问。&lt;br&gt;不得把重复提问改名为 answer / ack 来绕过限制。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="590" x="550" y="720" as="geometry" />
        </mxCell>
        <mxCell id="intent_v" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;验收条件&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;说明疑问时保留 question；&lt;br&gt;一般回应不自动放宽次数；&lt;br&gt;无疑问时正常回应或听课；&lt;br&gt;普通讲授不被频繁打断。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1200" y="720" as="geometry" />
        </mxCell>
        <mxCell id="intent_e1" edge="1" parent="1" source="intent_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="intent_r" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="intent_e2" edge="1" parent="1" source="intent_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="intent_v" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="version_c" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;运行版本｜服务仍用旧规则&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;后台启动时加载代码，开课时固定提示词。&lt;br&gt;刷新网页或新开课堂，&lt;br&gt;不保证后台已经更新。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="430" x="60" y="970" as="geometry" />
        </mxCell>
        <mxCell id="version_r" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;已实现 + 运行措施｜确认加载同一版本&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;停止旧后台，启动目标目录的新后台，再新开课堂。&lt;br&gt;ready / 请求日志已记录启动目录、版本、规则指纹。&lt;br&gt;页面显示当前服务版本，区分模型候选与实际发言。&lt;br&gt;确认真实课堂日志，而不只确认磁盘文件。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="590" x="550" y="970" as="geometry" />
        </mxCell>
        <mxCell id="version_v" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;新版方案验收条件&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;模型知晓常规两次上限；&lt;br&gt;日志有申请、校验、投递记录；&lt;br&gt;页面、后台、测试版本一致；&lt;br&gt;本次单独验收，不沿用旧结论。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1200" y="970" as="geometry" />
        </mxCell>
        <mxCell id="version_e1" edge="1" parent="1" source="version_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="version_r" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="version_e2" edge="1" parent="1" source="version_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="version_v" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="边界：模型先自觉遵守常规两次上限，程序负责兜底；教师明确询问疑问时，才可申请一次例外。&lt;br&gt;疑问不改名为 answer / ack；例外不解除静音、停顿、来源与知识前提限制。已实现；验收边界见同目录记录。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="1240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="history-and-verification" name="04｜问题从哪里来，以及怎样验收真正生效？">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1320" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#52657D;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="04｜问题从哪里来，以及怎样验收真正生效？" vertex="1">
          <mxGeometry height="55" width="1480" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="旧机制、新增机制与运行版本分开看；避免把所有“不说话”都归因于五状态机。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="old" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;改造前已有｜2026-09-26 · 初始版本 905a274&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;同题最多两次；两次后 deferred；重复 question 被清空。&lt;br&gt;模型可选择 silence；点名、停顿、静音、新输入取消旧回复也已有。&lt;br&gt;本次最新课堂的主要断点属于这组旧机制。&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="710" x="60" y="185" as="geometry" />
        </mxCell>
        <mxCell id="new" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;五状态机新增｜2026-10-14 · 2128328&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;新增 knowledge_ids 与不可用前提检查。&lt;br&gt;防止用冲突、失效或待复核知识作答。&lt;br&gt;误把描述冲突填为采用前提，会拦掉整条回复。&lt;br&gt;对应最初日志 eda4b60739fd，不同于次数限制。&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="710" x="830" y="185" as="geometry" />
        </mxCell>
        <mxCell id="patches" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#EDF4FF;strokeColor=#8CACDE;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;历史补丁的验证边界｜不代表本次新方案已通过&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;原文记录：279 项通过、8 项跳过；独立模型返回 ack，问题仍 deferred、次数为 2。&lt;br&gt;这些结果只针对旧的“改为简短回应”补丁；历史课堂还存在运行版本不一致。&lt;br&gt;本次已实现 question + 例外申请；336 项通过、8 项跳过，真实模型复测通过；详见验收记录。&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1480" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="accept-title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="建议的完整验收顺序｜先确认版本，再复现整段课堂，最后检查声音" vertex="1">
          <mxGeometry height="45" width="1480" x="60" y="640" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;1｜核对运行版本&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;查实际请求与 ready。&lt;br&gt;确认新版规则和目标目录。&lt;br&gt;未加载 → 先处理服务版本。&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="340" x="60" y="730" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;2｜验证常规两次上限&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;同题实际发出两次后暂缓。&lt;br&gt;无邀请时，模型不再主动问。&lt;br&gt;换 ID 或类型不得绕过上限。&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="340" x="440" y="730" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;3｜验证教师邀请例外&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;“还有疑问吗”→ question + 申请。&lt;br&gt;校验通过才出现 reply。&lt;br&gt;同一邀请不可重复放行。&lt;br&gt;泛泛点名不自动授权。&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="340" x="820" y="730" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;4｜核对播报链路&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;有 reply → 应显示文字。&lt;br&gt;开启播报 → 检查 speech / 错误。&lt;br&gt;静音时不应积压旧回复。&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="340" x="1200" y="730" as="geometry" />
        </mxCell>
        <mxCell id="verify_v1" edge="1" parent="1" source="v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="verify_v2" edge="1" parent="1" source="v2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="verify_v3" edge="1" parent="1" source="v3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stop" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=20;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;如何分辨未通过的位置&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:20px;line-height:1.45&quot;&gt;原始 silence：查意图判定和模型策略。&lt;br&gt;原始非 silence、提交变 silence：查知识前提、问题次数与恢复记录。&lt;br&gt;候选有效却无 reply：查静音、过期、忙碌和停顿；不要取消所有控制来“解决”。&lt;br&gt;已有 reply、没有声音：再查语音播报或设备。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="950" x="60" y="965" as="geometry" />
        </mxCell>
        <mxCell id="sources" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;依据与限制&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;前述日志与测试是历史证据。&lt;br&gt;第 5 页为本次实现方案。&lt;br&gt;程序与流程图已同步更新。&lt;br&gt;独立验收见同目录记录。&lt;br&gt;旧进程的具体来源尚未确认。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="460" x="1080" y="965" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="制图日期：2026-10-14 · 所有框、文字与连线可在 draw.io 中编辑；颜色只区分机制与方案状态。" vertex="1">
          <mxGeometry height="45" width="1480" x="60" y="1240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="question-release-request" name="05｜暂缓疑问：教师邀请下的例外放行（已实现）">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1430" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#52657D;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="05｜暂缓疑问：教师邀请下的例外放行" vertex="1">
          <mxGeometry height="55" width="1480" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="已实现 · 模型自觉遵守常规两次上限；超限提问须申请。离线、浏览器及真实模型复测通过，详见同目录验收记录。" vertex="1">
          <mxGeometry height="65" width="1480" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="normal" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;常规规则｜模型先自觉控制&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;同一疑问通常只提问一次，最多再澄清一次。&lt;br&gt;查看既有 ID、状态与已发次数；两次后 deferred。&lt;br&gt;未获新的明确邀请时继续听课，不主动连续第三问。&lt;br&gt;不靠程序每次拦截后才学会停下，不换 ID 或类型绕过。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="710" x="60" y="185" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;语义边界｜疑问仍是 question&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;教师明确询问是否有疑问，或要求说出疑问时，&lt;br&gt;有疑问就用 question；不强制改成 answer / ack。&lt;br&gt;仅问“懂吗 / 在吗”、要求回答题目或检查声音，&lt;br&gt;不自动等于允许重问暂缓疑问。无疑问不强造问题。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="710" x="830" y="185" as="geometry" />
        </mxCell>
        <mxCell id="flow_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#17304F;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" value="例外流程｜教师明确邀请 → 模型申请 → 程序校验 → 本次投递" vertex="1">
          <mxGeometry height="45" width="1480" x="60" y="420" as="geometry" />
        </mxCell>
        <mxCell id="invitation" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;1｜教师明确邀请&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;例如“还有什么疑问吗？”&lt;br&gt;或“把没弄懂的问题说出来”。&lt;br&gt;模型识别本次邀请及对应来源。&lt;br&gt;疑问仍未解决且处于暂缓。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="330" x="60" y="500" as="geometry" />
        </mxCell>
        <mxCell id="request" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;2｜模型附放行请求&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;候选保持 question。&lt;br&gt;申请关联原疑问 ID、&lt;br&gt;本次教师来源、申请理由。&lt;br&gt;不把“请求”读给教师听；&lt;br&gt;申请不等于获准或已经发出。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="330" x="440" y="500" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#F3EFFF;strokeColor=#B6A0D9;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;3｜程序校验&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;教师来源存在且邀请仍有效；&lt;br&gt;原疑问存在、未解决且暂缓；&lt;br&gt;申请与候选、邀请相匹配；&lt;br&gt;该邀请尚未实际使用。&lt;br&gt;仍须通过来源与前提校验。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="330" x="820" y="500" as="geometry" />
        </mxCell>
        <mxCell id="grant" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;4｜仅本次获准&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;通过：进入正常发言时机检查。&lt;br&gt;静音、忙碌、教师讲话时不发。&lt;br&gt;新输入使邀请失效时取消。&lt;br&gt;真正投递后才消耗本次许可。&lt;br&gt;同一邀请最多例外发出一次。&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="340" x="1200" y="500" as="geometry" />
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="invitation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="request" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="validate" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" edge="1" parent="1" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="grant" value="通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="no_invitation" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#F2F5F8;strokeColor=#BBC7D3;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;未获明确邀请｜不申请第三次主动追问&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;普通讲授、泛泛点名、检查声音都不能自行解封。&lt;br&gt;若教师要求回答具体问题，按实际内容回应；&lt;br&gt;不能把原疑问藏入 answer / ack 再次请求解释。&lt;br&gt;后续若有新的明确邀请，才可针对那次邀请重新申请。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="710" x="60" y="815" as="geometry" />
        </mxCell>
        <mxCell id="deny" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#FFF0ED;strokeColor=#D19B91;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;不通过｜保留暂缓&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;缺少申请、来源不符、已解决，&lt;br&gt;或同一邀请已经使用：拒绝。&lt;br&gt;不伪装成 answer 自动放行；&lt;br&gt;记录原因，保留有效学习进度。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="330" x="820" y="815" as="geometry" />
        </mxCell>
        <mxCell id="delivered" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;投递后｜照实记录&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:17px;line-height:1.45&quot;&gt;实际发出后累计次数 +1；&lt;br&gt;原问题保持 deferred。&lt;br&gt;不重置两次常规额度，&lt;br&gt;不因例外许可自动变回 asked。&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1200" y="815" as="geometry" />
        </mxCell>
        <mxCell id="reject" edge="1" parent="1" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="deny" value="未通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="delivery" edge="1" parent="1" source="grant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6985AB;fontFamily=PingFang SC;fontSize=16;fontColor=#52657D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="delivered" value="实际发出">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="checks" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=19;fontColor=#17304F;fillColor=#EAF7F0;strokeColor=#84BA9E;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;验收｜正常停止与正确放行都要测&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;① 两次后无明确邀请：模型主动 silence，无第三问。&lt;br&gt;② 明确邀请 + 有效申请：输出原 ID 的 question 并出现 reply。&lt;br&gt;③ 同一邀请重放、无申请、泛泛点名、已解决：不能例外放行。&lt;br&gt;④ 静音或新输入取消：不计已发次数，不把旧许可带到新输入。&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="710" x="60" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="logging" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=22;fontFamily=PingFang SC;fontSize=18;fontColor=#17304F;fillColor=#FFF6DF;strokeColor=#D4B164;strokeWidth=1.5;" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:1.25&quot;&gt;验收｜模型申请、程序决定与实际发出分开&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;日志应能对应：问题 ID → 邀请来源 → 放行请求 → 校验结果。&lt;br&gt;候选生成或校验通过都不算已问，只有实际 reply 才计数。&lt;br&gt;answer / ack 仅承担真实回答或应答，不用来替代疑问。&lt;br&gt;教师之后再次明确邀请时，需重新申请，不沿用旧许可。&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="710" x="830" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#52657D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" value="本页方案已实现；历史课堂与旧补丁测试不作为本次验收证据。重启后台并刷新页面后生效；声音听感另行确认。" vertex="1">
          <mxGeometry height="45" width="1480" x="60" y="1350" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
