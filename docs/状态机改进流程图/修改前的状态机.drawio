<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Codex" version="32.4.1" type="device" compressed="false"><diagram id="triggers" name="01 四种知识状态的触发条件"><mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;知识状态｜当前触发机制&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="基于当前仓库实现 · 2026-10-12 · 仅描述 knowledge 的四种状态，不涉及问题状态 pending / asked / resolved / deferred。&lt;br&gt;蓝色连线表示模型输出路径；状态选择由 AI 完成，不是程序依次执行四个判断条件。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="input" value="&lt;b&gt;课堂输入与认知上下文&lt;/b&gt;&lt;br&gt;明确前置知识 p、已讲内容 t、新教师片段、当前知识、失效知识与历史、确认画像" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="170" width="800" height="95" /></mxCell><mxCell id="ai" value="&lt;b&gt;同一次 AI 调用：先按语义分类，再选择知识状态&lt;/b&gt;&lt;br&gt;知识 → knowledge_updates；未解问题 → question_updates；课堂行为 → event_updates&lt;br&gt;只有知识条目进入下方四种状态。允许本轮不产生知识更新。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="305" width="980" height="105" /></mxCell><mxCell id="e_input" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="input" target="ai"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative｜暂定理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;提示词触发&lt;/b&gt;&lt;br&gt;新知识一般先 tentative。&lt;br&gt;简单、有依据的推导也先 tentative。&lt;br&gt;&lt;br&gt;&lt;b&gt;实际机制&lt;/b&gt;&lt;br&gt;AI 自行选择；并非 Schema 默认值。&lt;br&gt;不校验是否应当归为信息缺失。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="510" width="330" height="335" /></mxCell><mxCell id="e_tentative" value="AI 选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="ai" target="tentative"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="understood" value="&lt;b&gt;understood｜课堂推断理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;提示词触发&lt;/b&gt;&lt;br&gt;根据课堂回答、解释或应用等行为，可推断 understood。&lt;br&gt;&lt;br&gt;&lt;b&gt;实际机制&lt;/b&gt;&lt;br&gt;没有必需的验证步骤或次数。&lt;br&gt;不强制先经历 tentative。&lt;br&gt;不代表标准答案或永久掌握。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="510" width="330" height="335" /></mxCell><mxCell id="e_understood" value="AI 选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="ai" target="understood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear｜信息缺失&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;缺少明确触发条件&lt;/b&gt;&lt;br&gt;Schema 接受该状态，但提示词没有规定何时必须输出 unclear。&lt;br&gt;&lt;br&gt;&lt;b&gt;实际机制&lt;/b&gt;&lt;br&gt;只有 AI 主动输出时才会写入。&lt;br&gt;程序没有自动转入规则。&lt;br&gt;未解问题不会自动改变知识状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="510" width="330" height="335" /></mxCell><mxCell id="e_unclear" value="AI 选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="ai" target="unclear"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜冲突或失效&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;提示词触发&lt;/b&gt;&lt;br&gt;教师明确纠正时，旧规则必须变为 conflict。&lt;br&gt;&lt;br&gt;&lt;b&gt;程序触发&lt;/b&gt;&lt;br&gt;AI 的新条目通过 supersedes 指向旧条目时，程序将对应旧条目标为 conflict。&lt;br&gt;前后矛盾没有独立自动检测器。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="510" width="330" height="335" /></mxCell><mxCell id="e_conflict" value="AI 选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="ai" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="valid" value="&lt;b&gt;下一轮：当前有效知识 knowledge&lt;/b&gt;&lt;br&gt;tentative + understood&lt;br&gt;可用于后续推理；“暂定”没有单独的程序使用门槛。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="935" width="620" height="115" /></mxCell><mxCell id="inactive" value="&lt;b&gt;下一轮：inactive_knowledge&lt;/b&gt;&lt;br&gt;unclear + conflict&lt;br&gt;与历史记录分开提供；提示模型不能作为当前有效事实。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="935" width="620" height="115" /></mxCell><mxCell id="out_tentative" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tentative" target="valid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out_understood" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="understood" target="valid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out_unclear" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="unclear" target="inactive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out_conflict" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="inactive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="gap" value="&lt;b&gt;当前缺口：&lt;/b&gt;“新知识 → tentative”有明确指令；“缺少必要信息 → unclear”没有对应指令。&lt;br&gt;缺失解释可被记成 open_questions，而相关知识仍留在 tentative；问题解决也不会由程序自动升级知识状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1090" width="1500" height="95" /></mxCell><mxCell id="refs" value="实现依据：backend/prompts.py:58–88 · backend/schemas.py:94–101、166–173 · backend/policy.py:44–74" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1200" width="1500" height="30" /></mxCell></root></mxGraphModel></diagram><diagram id="writeback" name="02 状态写入、转换与 AI 依据"><mxGraphModel dx="1600" dy="1530" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1530" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;状态写入｜模型建议与程序执行边界&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="实线：程序处理；虚线：提示词要求，由 AI 执行。四状态没有严格的转换白名单，也没有固定的先后顺序。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="result" value="&lt;b&gt;AI 输出 StudentResult&lt;/b&gt;&lt;br&gt;knowledge_updates：id / text / status / sources / supersedes&lt;br&gt;每轮另有一个 note；不是逐条状态依据。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="180" width="810" height="110" /></mxCell><mxCell id="validate" value="&lt;b&gt;格式与关联校验&lt;/b&gt;&lt;br&gt;status 必须属于四种枚举；sources 非空且 ID 存在。&lt;br&gt;supersedes 必须指向已有知识。&lt;br&gt;不核验来源正文是否足以支持该状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="350" width="810" height="130" /></mxCell><mxCell id="v" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="result" target="validate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="same" value="已有同 ID 条目，&lt;br&gt;且内容或状态发生变化？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="545" width="330" height="140" /></mxCell><mxCell id="vs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="validate" target="same"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="archive" value="&lt;b&gt;保存旧版本&lt;/b&gt;&lt;br&gt;写入 knowledge_history&lt;br&gt;同 ID 修改本身不会自动把旧版本改为 conflict。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="565" width="390" height="100" /></mxCell><mxCell id="yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="same" target="archive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="super" value="supersedes 指向&lt;br&gt;其他已有知识？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="795" width="330" height="140" /></mxCell><mxCell id="no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="same" target="super"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="after" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="archive" target="super"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="invalidate" value="&lt;b&gt;被替代旧条目 → conflict&lt;/b&gt;&lt;br&gt;旧状态不是 conflict 时：&lt;br&gt;先保存旧版本，再自动改为 conflict。&lt;br&gt;这是程序强制执行的状态转换。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="805" width="390" height="120" /></mxCell><mxCell id="sy" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="super" target="invalidate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="commit" value="&lt;b&gt;写入 AI 给出的当前条目&lt;/b&gt;&lt;br&gt;known[item.id] = item&lt;br&gt;新建或覆盖；程序不强制升级、降级或转换顺序。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1010" width="810" height="100" /></mxCell><mxCell id="sn" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="super" target="commit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ic" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="invalidate" target="commit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="next" value="&lt;b&gt;提交整轮状态 → 为下一轮分层&lt;/b&gt;&lt;br&gt;tentative / understood → knowledge&lt;br&gt;unclear / conflict → inactive_knowledge；历史另存" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1170" width="810" height="110" /></mxCell><mxCell id="cn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="commit" target="next"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p" value="&lt;b&gt;AI 实际收到的状态提示词原文&lt;/b&gt;&lt;br&gt;&lt;br&gt;“更新认知：听过不等于理解。新知识一般先 tentative；根据课堂回答、解释或应用等行为可推断 understood。”&lt;br&gt;&lt;br&gt;“understood 只是课堂推断理解，不代表标准答案或永久掌握。老师说答对了或学生自称懂了不能产生 verified。”&lt;br&gt;&lt;br&gt;“允许简单的有依据推导，并先标 tentative。”&lt;br&gt;&lt;br&gt;“教师明确纠正时，旧规则必须变为 conflict，不得删去或继续使用。规则尚未补充完整时，不得猜测新规则。”&lt;br&gt;&lt;br&gt;“相同 ID 被纠正时更新该条目，supersedes 留空，程序保存旧版本；新规则使用不同 ID 时，在 supersedes 列出被纠正的旧知识 ID。”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="180" width="580" height="560" /></mxCell><mxCell id="evidence" value="&lt;b&gt;AI 生成依据的要求&lt;/b&gt;&lt;br&gt;&lt;br&gt;“每条知识更新附来源 ID（p 为明确前置知识，t 为已讲内容）。”&lt;br&gt;&lt;br&gt;“note 只写简短可观察的依据，不输出长篇思维过程。”&lt;br&gt;&lt;br&gt;&lt;b&gt;结构限制&lt;/b&gt;&lt;br&gt;sources：每条知识独立填写。&lt;br&gt;note：整轮共用，可为空，最多 400 字。&lt;br&gt;没有每条知识的 status_reason 字段，也没有逐条状态解释的强制要求。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="775" width="580" height="360" /></mxCell><mxCell id="boundary" value="&lt;b&gt;提示词要求 ≠ 程序强制&lt;/b&gt;&lt;br&gt;AI 可直接生成任一状态，也可用同 ID 更新为任一状态；程序没有状态转换白名单。&lt;br&gt;教师纠正并不会由程序直接识别；supersedes 的旧条目失效才是自动执行。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="1170" width="580" height="160" /></mxCell><mxCell id="limits" value="&lt;b&gt;校验失败：&lt;/b&gt;模型调用最多两次尝试，失败后不将未通过校验的整轮结果写入状态。&lt;br&gt;&lt;b&gt;说明：&lt;/b&gt;来源存在只证明引用有效，不证明理解正确；verified 不属于当前四种状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1340" width="1470" height="100" /></mxCell><mxCell id="refs" value="实现依据：backend/policy.py:44–74 · backend/schemas.py:94–101、138–148 · backend/prompts.py:64–74、88 · backend/llm.py:23–35" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1460" width="1500" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>