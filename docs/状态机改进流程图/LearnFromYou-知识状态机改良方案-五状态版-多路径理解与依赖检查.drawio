<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Codex" version="32.4.1" type="device" compressed="false"><diagram id="decision" name="01 改良方案：状态判定"><mxGraphModel dx="1600" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1620" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;知识状态机改良方案｜五状态判定&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · 尚未实施到代码。状态描述学生当前理解与接受知识的情况，不直接裁定教师对错。&lt;br&gt;独立知识分别判定；允许不同讲解路径建立理解。第 4 页补充多路径重新判定与推导依赖检查。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="input" value="&lt;b&gt;教师新讲授的知识点&lt;/b&gt;&lt;br&gt;结合确认画像、具体前置知识 p、课堂有效知识 t 与当前讲解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="175" width="700" height="95" /></mxCell><mxCell id="compare" value="&lt;b&gt;拆成可独立判断的知识条目，再识别条件&lt;/b&gt;&lt;br&gt;独立结论分别记录，避免局部纠错导致整条知识失效&lt;br&gt;识别必要基础、步骤与适用条件；年级只作辅助判断" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="325" width="700" height="105" /></mxCell><mxCell id="in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="input" target="compare"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d1" value="在相同适用条件下，&lt;br&gt;与画像已有知识或课堂知识&lt;br&gt;存在尚未解决的矛盾？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="490" width="440" height="150" /></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="compare" target="d1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜矛盾待解决&lt;/b&gt;&lt;br&gt;相同适用条件下，新旧说法互相矛盾&lt;br&gt;关联双方 p / k 条目、来源与矛盾说明&lt;br&gt;不自动认定哪方错误，不自动让旧知识失效" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="505" width="470" height="125" /></mxCell><mxCell id="yes1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d2" value="在当前讲解路径下，&lt;br&gt;缺少必要基础或说明，&lt;br&gt;无法建立理解链条？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="740" width="440" height="150" /></mxCell><mxCell id="no1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear｜必要信息或基础缺失&lt;/b&gt;&lt;br&gt;记录当前无法理解的具体知识与原因&lt;br&gt;缺口是诊断依据，不是唯一解除条件&lt;br&gt;允许例子、表格、类比等其他路径建立理解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="755" width="470" height="125" /></mxCell><mxCell id="yes2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C59B45;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="unclear"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d3" value="教师存在跳步，&lt;br&gt;但凭已有知识与已讲内容&lt;br&gt;能补出中间过程？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="990" width="440" height="150" /></mxCell><mxCell id="no2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative｜可接受的跳步推断&lt;/b&gt;&lt;br&gt;仅用于有跳步但可以补出的情况&lt;br&gt;记录跳过哪一步、凭哪些依据补出&lt;br&gt;推断仍待确认，不是新知识默认状态" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1005" width="470" height="125" /></mxCell><mxCell id="yes3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="tentative"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="understood" value="&lt;b&gt;understood｜当前可推断理解&lt;/b&gt;&lt;br&gt;基础足够，讲解链条完整；可直接进入&lt;br&gt;或原有缺口已补齐，并表现出理解&lt;br&gt;仍不代表经验证的稳定掌握" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="1260" width="440" height="140" /></mxCell><mxCell id="no3" value="无待确认跳步；理解链条完整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="understood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="guard" value="&lt;b&gt;判定保护&lt;/b&gt;&lt;br&gt;无法指出学生已有依据，不强行 understood。&lt;br&gt;缺口不是固定补讲清单；可寻找其他理解路径。&lt;br&gt;无法证明能补出跳步时，不使用 tentative。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="995" width="340" height="150" /></mxCell><mxCell id="guardedge" value="检查不足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="guard" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="revoke" value="&lt;b&gt;invalid｜已失效（独立路径）&lt;/b&gt;&lt;br&gt;教师明确撤回 / 纠正某条旧规则，或新规则明确替代旧规则；必须能定位具体旧条目&lt;br&gt;→ 旧条目直接 invalid，无需先经过 conflict&lt;br&gt;→ 保存失效依据与历史；有替代规则时关联新条目&lt;br&gt;→ 新规则重新走主判定流程，不自动 understood" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="490" width="340" height="255" /></mxCell><mxCell id="req" value="&lt;b&gt;每条状态的最小依据&lt;/b&gt;&lt;br&gt;共同：独立知识内容、适用范围、状态原因、来源及推导依赖。unclear：当前理解障碍；tentative：跳步与补步依据；conflict：双方知识与矛盾；understood：实际理解范围与依据；invalid：失效原因、纠正来源及替代关联。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1470" width="1480" height="100" /></mxCell></root></mxGraphModel></diagram><diagram id="recovery" name="02 改良方案：状态解除与知识使用"><mxGraphModel dx="1600" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1550" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;五状态方案｜解除、修订与使用&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · 新讲解或课堂表现可通过任一合理路径支持重新判定，无需沿原缺口逐项补齐。&lt;br&gt;只更新有依据的具体理解范围；相关前提变化时，检查依赖结论。invalid 旧版本继续保留历史。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear&lt;/b&gt;&lt;br&gt;关键基础或信息不足" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="400" height="95" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative&lt;/b&gt;&lt;br&gt;可补出的跳步，推断待确认" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="190" width="400" height="95" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict&lt;/b&gt;&lt;br&gt;尚未解决的矛盾" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="190" width="400" height="95" /></mxCell><mxCell id="uaction" value="&lt;b&gt;通过任一合理路径建立理解&lt;/b&gt;&lt;br&gt;可补讲基础，也可用例子、表格、类比等&lt;br&gt;原缺口不要求逐项补齐&lt;br&gt;检查具体理解范围与学生已有依据" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="370" width="400" height="125" /></mxCell><mxCell id="taction" value="&lt;b&gt;新增可观察的理解依据&lt;/b&gt;&lt;br&gt;可补全原步骤，也可用其他解释或应用&lt;br&gt;判断原来的待确认推断是否已获得支持&lt;br&gt;不能只凭“我懂了”就自动升级" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="370" width="400" height="125" /></mxCell><mxCell id="caction" value="&lt;b&gt;教师澄清条件或明确纠正&lt;/b&gt;&lt;br&gt;条件不同：修订适用范围，双方可保留&lt;br&gt;明确纠正：旧条目 invalid&lt;br&gt;保留 / 修订后的规则重新判断" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="370" width="400" height="125" /></mxCell><mxCell id="aunclear" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="unclear" target="uaction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="atentative" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tentative" target="taction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="aconflict" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="caction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="reevaluate" value="&lt;b&gt;根据当前可获得的依据，重新走第 1 页判定&lt;/b&gt;&lt;br&gt;允许不同讲解路径；判断现在能否理解这条具体知识，以及凭什么。&lt;br&gt;未解决矛盾 → conflict；当前关键缺口 → unclear；可补跳步 → tentative；理解完整 → understood。&lt;br&gt;只理解了部分内容时，拆分条目分别判定，不把局部理解升级为整片掌握。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="610" width="1120" height="155" /></mxCell><mxCell id="ruaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="uaction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rtaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="taction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rcaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="caction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="profile" value="&lt;b&gt;画像前置知识 p 的冲突处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 关联画像中的具体前置知识 ID，记录双方来源和条件。&lt;br&gt;2. 发现可识别的同条件矛盾 → conflict，等待澄清。&lt;br&gt;3. 条件不同 → 修订范围；教师明确纠正 → 旧前置知识 invalid，修订后的当前规则重新判定。&lt;br&gt;4. 保存原始画像与历史；后续上下文使用修订后的基础，避免旧设定反复制造同一冲突。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="820" width="690" height="260" /></mxCell><mxCell id="historical" value="&lt;b&gt;冲突与失效拆为两个状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;conflict：&lt;/b&gt;双方说法矛盾，尚未解决。&lt;br&gt;必须关联双方知识、各自来源与适用条件。&lt;br&gt;澄清条件后，双方可能都保留。&lt;br&gt;&lt;br&gt;&lt;b&gt;invalid：&lt;/b&gt;旧规则被明确撤回、纠正或替代。&lt;br&gt;必须关联旧条目与教师纠正来源；有替代规则时关联新条目。保留历史，停止使用。&lt;br&gt;&lt;br&gt;发现矛盾不等于已有规则失效。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="820" width="690" height="260" /></mxCell><mxCell id="useu" value="&lt;b&gt;understood 的使用&lt;/b&gt;&lt;br&gt;进入当前有效知识，可用于后续推理。&lt;br&gt;遇到新证据仍可重新判断。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1170" width="350" height="145" /></mxCell><mxCell id="uset" value="&lt;b&gt;tentative 的使用&lt;/b&gt;&lt;br&gt;保留不确定标记，有条件参与推理。&lt;br&gt;后续推断继承未确认前提；不能把它&lt;br&gt;无条件当成确定事实传播。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1170" width="350" height="145" /></mxCell><mxCell id="usei" value="&lt;b&gt;unclear / conflict 的使用&lt;/b&gt;&lt;br&gt;保留为理解障碍与待澄清内容。&lt;br&gt;不作为确定事实使用。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1170" width="350" height="145" /></mxCell><mxCell id="question" value="&lt;b&gt;与问题生命周期及依赖的关系&lt;/b&gt;&lt;br&gt;问题 resolved 不直接等于知识 understood；其他讲解路径也可建立理解，无需先回答原问题。&lt;br&gt;相关前提被修订或失效时，触发依赖结论检查；不自动判错，也不继续无条件使用。详见第 4 页。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1360" width="1460" height="115" /></mxCell><mxCell id="useinvalid" value="&lt;b&gt;invalid 的使用&lt;/b&gt;&lt;br&gt;停止用于后续推理。&lt;br&gt;只保留历史及失效依据。&lt;br&gt;重新采用时创建新版本并重新判定，不静默复活旧条目。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="1170" width="350" height="145" /></mxCell></root></mxGraphModel></diagram><diagram id="conflict-invalid" name="03 conflict 与 invalid：条件、关联与转换"><mxGraphModel dx="1600" dy="1610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1610" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;conflict ↔ invalid｜判断条件与关联关系&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · conflict 表示知识之间的待解决矛盾；invalid 表示某一旧条目已经失效。&lt;br&gt;教师讲错但学生无法发现时，按当时依据判理解状态；不能借助事后纠正倒推当时应为 conflict。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="new" value="&lt;b&gt;教师新增说法 / 纠正说明&lt;/b&gt;&lt;br&gt;结合学生可获得的已有知识与来源判断" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="170" width="600" height="90" /></mxCell><mxCell id="explicit" value="教师明确撤回、纠正或替代，&lt;br&gt;且能定位具体旧条目？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="325" width="500" height="150" /></mxCell><mxCell id="ne" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="new" target="explicit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="invalid" value="&lt;b&gt;旧条目 → invalid｜已失效&lt;/b&gt;&lt;br&gt;关联：旧知识 ID、教师纠正来源&lt;br&gt;有新规则时记录替代知识 ID&lt;br&gt;明确失效，不代表已证明在所有条件下错误" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="340" width="430" height="145" /></mxCell><mxCell id="ei" value="是：直接失效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="explicit" target="invalid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="contradiction" value="学生凭已有内容能识别：&lt;br&gt;同一适用条件下，&lt;br&gt;双方说法互相矛盾？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="575" width="500" height="150" /></mxCell><mxCell id="ec" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="explicit" target="contradiction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜矛盾待解决&lt;/b&gt;&lt;br&gt;关联：双方 p / k 条目、各自来源&lt;br&gt;记录：适用条件与具体矛盾&lt;br&gt;暂不认定哪方错误；后说的也不自动优先" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="590" width="430" height="145" /></mxCell><mxCell id="cc" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="contradiction" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="normal" value="&lt;b&gt;按当前理解条件判断&lt;/b&gt;&lt;br&gt;当前路径关键基础缺失 → unclear&lt;br&gt;可补出的跳步 → tentative；理解完整 → understood&lt;br&gt;允许其他讲解路径建立理解&lt;br&gt;未知事实错误不借助外部知识自动识别" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="590" width="400" height="160" /></mxCell><mxCell id="cn" value="否 / 无发现依据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="contradiction" target="normal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="clarify" value="&lt;b&gt;教师后续澄清&lt;/b&gt;&lt;br&gt;尚未澄清：保持 conflict&lt;br&gt;普通补充或重复讲解不能触发 invalid" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="820" width="430" height="110" /></mxCell><mxCell id="cq" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="clarify"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="branch" value="后续说明解决了什么？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="1000" width="430" height="120" /></mxCell><mxCell id="qb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clarify" target="branch"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conditions" value="&lt;b&gt;适用条件不同&lt;/b&gt;&lt;br&gt;修订范围，双方都可能保留&lt;br&gt;相关当前条目重新判定&lt;br&gt;不能仅因扩展范围就让旧规则失效" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="1190" width="430" height="145" /></mxCell><mxCell id="bc" value="澄清条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="branch" target="conditions"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="corrected" value="&lt;b&gt;明确纠正其中一条&lt;/b&gt;&lt;br&gt;被纠正旧条目 → invalid&lt;br&gt;其余保留 / 修订规则重新判定&lt;br&gt;新规则不自动 understood" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="1190" width="430" height="145" /></mxCell><mxCell id="br" value="明确纠正" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="branch" target="corrected"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="replacement" value="&lt;b&gt;直接失效后的处理&lt;/b&gt;&lt;br&gt;有替代规则 → 回到第 1 页重新判定&lt;br&gt;只有撤回 → 不猜测替代规则&lt;br&gt;保留旧状态历史与失效来源" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="340" width="400" height="145" /></mxCell><mxCell id="ir" value="处理替代规则" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="invalid" target="replacement"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="history" value="&lt;b&gt;历史记录示例&lt;/b&gt;&lt;br&gt;教师错误讲授，学生当时理解 → understood；后来教师明确改正 → 旧条目 invalid。&lt;br&gt;保留“当时 understood，后来 invalid”的时间过程。&lt;br&gt;仅有新说法、普通补充或重复讲解，不构成明确失效。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1410" width="1460" height="130" /></mxCell></root></mxGraphModel></diagram><diagram id="flexible-dependencies" name="04 多路径理解、独立条目与推导依赖"><mxGraphModel dx="1600" dy="1670" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1670" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;五状态方案补充｜多路径理解与依赖检查&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · 不新增状态。理解缺口用于诊断，不是固定的补讲清单；状态变化必须有学生可获得的依据。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="lefttitle" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;A｜不同路径都可以支持理解&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="170" width="710" height="50" /></mxCell><mxCell id="righttitle" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;B｜前提改变，检查依赖结论&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="170" width="670" height="50" /></mxCell><mxCell id="new" value="&lt;b&gt;新讲解或课堂表现到来&lt;/b&gt;&lt;br&gt;补讲、例子、表格、类比、解释或应用&lt;br&gt;可对应原缺口，也可通过其他路径建立理解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="245" width="710" height="105" /></mxCell><mxCell id="evidence" value="有学生可获得的依据，&lt;br&gt;支持对具体知识 / 理解范围&lt;br&gt;作出新的判断？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="210" y="420" width="410" height="145" /></mxCell><mxCell id="new-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="new" target="evidence"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="keep" value="&lt;b&gt;没有新的判断依据&lt;/b&gt;&lt;br&gt;保留当前状态&lt;br&gt;不凭重复次数自动升级&lt;br&gt;不把原缺口当唯一入口" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="650" width="280" height="145" /></mxCell><mxCell id="scope" value="&lt;b&gt;明确实际理解到了哪一层&lt;/b&gt;&lt;br&gt;拆分独立结论 / 理解范围&lt;br&gt;只更新有依据的部分&lt;br&gt;再走五状态判定流程" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="650" width="380" height="145" /></mxCell><mxCell id="eno" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="evidence" target="keep"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="eyes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="evidence" target="scope"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="example" value="&lt;b&gt;例：学生不懂坐标，但教师改用数量表&lt;/b&gt;&lt;br&gt;数量表帮助学生理解一次函数中的数量关系&lt;br&gt;→ 该关系可以重新判定为 understood。&lt;br&gt;尚不能读函数图像 → 图像相关条目仍可为 unclear。&lt;br&gt;不必先补完坐标，也不把局部理解当成整片掌握。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="880" width="710" height="210" /></mxCell><mxCell id="changed" value="&lt;b&gt;前提 A 被修订、明确失效，&lt;br&gt;或相关状态 / 适用条件改变&lt;/b&gt;&lt;br&gt;记录结论 B 的推导依赖 A，区别于原始来源引用" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="245" width="670" height="105" /></mxCell><mxCell id="affected" value="该变化是否影响&lt;br&gt;B 所用的前提或适用条件？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="420" width="410" height="145" /></mxCell><mxCell id="ca" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="changed" target="affected"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="unaffected" value="&lt;b&gt;不影响推导&lt;/b&gt;&lt;br&gt;保留 B 当前状态&lt;br&gt;记录检查依据" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="650" width="270" height="145" /></mxCell><mxCell id="review" value="&lt;b&gt;重新检查 B 的成立依据&lt;/b&gt;&lt;br&gt;还有独立依据吗？&lt;br&gt;修订后的前提仍支持推导吗？&lt;br&gt;缺了哪部分理解依据？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="650" width="350" height="145" /></mxCell><mxCell id="ano" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="affected" target="unaffected"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ayes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="affected" target="review"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rejudge" value="&lt;b&gt;B 按具体依据重新走五状态判定&lt;/b&gt;&lt;br&gt;有独立依据且理解完整：可保留 understood。&lt;br&gt;关键依据缺失：可为 unclear；矛盾未解：conflict。&lt;br&gt;只有符合可补跳步条件时才用 tentative。&lt;br&gt;教师明确撤回 / 纠正 B 时，B 才进入 invalid。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="880" width="670" height="210" /></mxCell><mxCell id="rr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="review" target="rejudge"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="guard" value="&lt;b&gt;依赖检查期间&lt;/b&gt;&lt;br&gt;不自动把 B 判错；存在受影响且未确认的前提时，不继续无条件使用 B。&lt;br&gt;沿受影响的推导链检查后续结论；这些检查不需要新建第六种知识状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1140" width="670" height="150" /></mxCell><mxCell id="rg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rejudge" target="guard"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="split" value="&lt;b&gt;C｜独立结论分别记录，局部纠正只影响对应条目&lt;/b&gt;&lt;br&gt;不要将“正方形四条边相等”和“面积等于边长乘以四”塞在同一条知识里。&lt;br&gt;教师纠正面积公式 → 旧面积条目 invalid；边的性质保留。错误面积公式所支持的其他结论触发依赖检查。&lt;br&gt;条目大小以能独立判断、独立修订为准，不按字数或句子数量机械切分。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1350" width="1470" height="160" /></mxCell><mxCell id="record" value="&lt;b&gt;变化记录：&lt;/b&gt;保存前后状态、教师 / 课堂依据、实际理解范围、涉及的前提与修订原因。&lt;br&gt;判定依据应来自学生已有基础与已讲内容；AI 自己知道答案不能作为学生理解的证明。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1540" width="1470" height="95" /></mxCell></root></mxGraphModel></diagram></mxfile>