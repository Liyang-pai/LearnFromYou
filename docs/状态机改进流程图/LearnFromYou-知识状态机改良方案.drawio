<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Codex" version="32.4.1" type="device" compressed="false"><diagram id="decision" name="01 改良方案：状态判定"><mxGraphModel dx="1600" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1620" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;知识状态机改良方案｜状态判定&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-13 · 尚未实施到代码。状态描述学生当前能否理解并接受知识，不用于直接裁定教师对错。&lt;br&gt;本页处理当前知识；已明确被替代的历史条目保持 conflict / superseded，不重新当作有效规则。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="input" value="&lt;b&gt;教师新讲授的知识点&lt;/b&gt;&lt;br&gt;结合确认画像、具体前置知识 p、课堂有效知识 t 与当前讲解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="175" width="700" height="95" /></mxCell><mxCell id="compare" value="&lt;b&gt;先识别知识及适用条件&lt;/b&gt;&lt;br&gt;提取必要前置知识、讲解步骤、已有规则与条件&lt;br&gt;年级只作辅助；不能仅因“小学 + 一次函数”就判定不理解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="325" width="700" height="105" /></mxCell><mxCell id="in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="input" target="compare"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d1" value="在相同适用条件下，&lt;br&gt;与画像已有知识或课堂知识&lt;br&gt;存在尚未解决的矛盾？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="490" width="440" height="150" /></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="compare" target="d1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜未解决的认知冲突&lt;/b&gt;&lt;br&gt;reason = contradiction&lt;br&gt;关联冲突的 p / k 条目与教师来源&lt;br&gt;双方说法保留；不自动认定新知识错误" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="505" width="470" height="125" /></mxCell><mxCell id="yes1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d2" value="缺少必要前置知识，&lt;br&gt;或讲解跨度超出理解基础，&lt;br&gt;无法建立理解链条？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="740" width="440" height="150" /></mxCell><mxCell id="no1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear｜必要信息或基础缺失&lt;/b&gt;&lt;br&gt;记录具体缺失的前置知识 / 解释步骤&lt;br&gt;如直接使用未学过的变量、坐标或概念&lt;br&gt;关键缺口无法靠现有知识补齐" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="755" width="470" height="125" /></mxCell><mxCell id="yes2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C59B45;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="unclear"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d3" value="教师存在跳步，&lt;br&gt;但凭已有知识与已讲内容&lt;br&gt;能补出中间过程？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="990" width="440" height="150" /></mxCell><mxCell id="no2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative｜可接受的跳步推断&lt;/b&gt;&lt;br&gt;仅用于有跳步但可以补出的情况&lt;br&gt;记录跳过哪一步、凭哪些依据补出&lt;br&gt;推断仍待确认，不是新知识默认状态" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1005" width="470" height="125" /></mxCell><mxCell id="yes3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="tentative"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="understood" value="&lt;b&gt;understood｜当前可推断理解&lt;/b&gt;&lt;br&gt;基础足够，讲解链条完整；可直接进入&lt;br&gt;或原有缺口已补齐，并表现出理解&lt;br&gt;仍不代表经验证的稳定掌握" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="1260" width="440" height="140" /></mxCell><mxCell id="no3" value="无待确认跳步；理解链条完整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="understood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="guard" value="&lt;b&gt;判定保护&lt;/b&gt;&lt;br&gt;若无法指出具体依据，不强行判 understood。&lt;br&gt;回到缺口检查：记录无法确定的必要信息；&lt;br&gt;无法证明能补出跳步时，不使用 tentative。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="995" width="340" height="150" /></mxCell><mxCell id="guardedge" value="检查不足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="guard" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="revoke" value="&lt;b&gt;独立的历史失效路径&lt;/b&gt;&lt;br&gt;教师明确撤回 / 纠正旧规则，或新规则明确替代旧规则&lt;br&gt;→ 被替代旧条目 conflict，reason = superseded&lt;br&gt;→ 新规则重新走本页判断，不自动设为 understood" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="490" width="340" height="255" /></mxCell><mxCell id="req" value="&lt;b&gt;每条状态的最小依据&lt;/b&gt;&lt;br&gt;共同字段：状态原因、来源 ID、适用条件。unclear：缺失基础 / 信息；tentative：跳步与补步依据；conflict：冲突对象及两方来源；understood：完整理解链条或课堂表现。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1470" width="1480" height="100" /></mxCell></root></mxGraphModel></diagram><diagram id="recovery" name="02 改良方案：状态解除与知识使用"><mxGraphModel dx="1600" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1550" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;知识状态机改良方案｜解除、修订与使用&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 与第 1 页判定流程配套。补充、确认或纠正到来后重新判断，不设置“听过几次就升级”的计数规则。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear&lt;/b&gt;&lt;br&gt;关键基础或信息不足" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="400" height="95" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative&lt;/b&gt;&lt;br&gt;可补出的跳步，推断待确认" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="190" width="400" height="95" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict / contradiction&lt;/b&gt;&lt;br&gt;尚未解决的矛盾" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="190" width="400" height="95" /></mxCell><mxCell id="uaction" value="&lt;b&gt;教师补齐前置基础或解释&lt;/b&gt;&lt;br&gt;搭桥、降低讲解难度、补充必要定义&lt;br&gt;检查原来的具体缺口是否消除" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="370" width="400" height="125" /></mxCell><mxCell id="taction" value="&lt;b&gt;新增可观察的确认依据&lt;/b&gt;&lt;br&gt;教师补全步骤；学生解释、回答或应用&lt;br&gt;不能只凭“我懂了”就自动升级" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="370" width="400" height="125" /></mxCell><mxCell id="caction" value="&lt;b&gt;教师澄清条件或明确纠正&lt;/b&gt;&lt;br&gt;区分适用范围扩展与同条件矛盾&lt;br&gt;明确保留 / 修订 / 替代哪条规则" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="370" width="400" height="125" /></mxCell><mxCell id="aunclear" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="unclear" target="uaction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="atentative" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tentative" target="taction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="aconflict" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="caction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="reevaluate" value="&lt;b&gt;重新走第 1 页的状态判定&lt;/b&gt;&lt;br&gt;未解决矛盾 → conflict；关键缺口 → unclear；可补的跳步 → tentative；完整理解 → understood&lt;br&gt;原问题尚存时保留对应状态；新证据也可以使 understood 重新进入其他状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="610" width="1120" height="130" /></mxCell><mxCell id="ruaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="uaction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rtaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="taction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rcaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="caction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="profile" value="&lt;b&gt;画像前置知识 p 的冲突处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 用 ID 关联画像中的具体已有知识，不仅关联画像全文。&lt;br&gt;2. 保存双方陈述、来源及适用条件，等待澄清。&lt;br&gt;3. 教师解释条件后，修订规则的适用范围；明确纠正后，更新当前采用的前置知识。&lt;br&gt;4. 保留原始画像 / 版本历史；后续上下文使用修订后的有效基础，避免旧设定反复制造同一冲突。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="820" width="690" height="260" /></mxCell><mxCell id="historical" value="&lt;b&gt;冲突与失效采用不同原因&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;contradiction：&lt;/b&gt;双方说法矛盾，尚未解决。&lt;br&gt;澄清后重新判定当前条目。&lt;br&gt;&lt;br&gt;&lt;b&gt;superseded：&lt;/b&gt;旧规则已明确被撤回或替代。&lt;br&gt;旧条目保持失效，保存历史；修订后的当前规则重新判定。&lt;br&gt;&lt;br&gt;“发现冲突”不等于“已有规则已经失效”。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="820" width="690" height="260" /></mxCell><mxCell id="useu" value="&lt;b&gt;understood 的使用&lt;/b&gt;&lt;br&gt;进入当前有效知识，可用于后续推理。&lt;br&gt;遇到新证据仍可重新判断。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1170" width="450" height="130" /></mxCell><mxCell id="uset" value="&lt;b&gt;tentative 的使用&lt;/b&gt;&lt;br&gt;保留不确定标记，有条件参与推理。&lt;br&gt;后续推断继承未确认前提；不能把它&lt;br&gt;无条件当成确定事实传播。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="1170" width="450" height="130" /></mxCell><mxCell id="usei" value="&lt;b&gt;unclear / conflict 的使用&lt;/b&gt;&lt;br&gt;保留为理解障碍与待澄清内容。&lt;br&gt;不作为确定事实使用。&lt;br&gt;superseded 旧规则仅作历史。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="1170" width="450" height="130" /></mxCell><mxCell id="question" value="&lt;b&gt;与问题生命周期的关系&lt;/b&gt;&lt;br&gt;缺口或矛盾可以生成关联问题，但问题 resolved 不直接等于知识 understood。&lt;br&gt;教师解释到来后，知识状态独立重新判定；不依赖是否实际发出提问。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1360" width="1460" height="115" /></mxCell></root></mxGraphModel></diagram></mxfile>