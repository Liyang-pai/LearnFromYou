<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Codex" version="32.4.1" type="device" compressed="false"><diagram id="decision" name="01 改良方案：状态判定"><mxGraphModel dx="1600" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1620" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;知识状态机改良方案｜五状态判定&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · 尚未实施到代码。状态描述学生当前理解与接受知识的情况，不直接裁定教师对错。&lt;br&gt;当前知识走主判定流程；明确撤回 / 纠正 / 替代的旧条目走左侧 invalid 路径，完整关系见第 3 页。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="input" value="&lt;b&gt;教师新讲授的知识点&lt;/b&gt;&lt;br&gt;结合确认画像、具体前置知识 p、课堂有效知识 t 与当前讲解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="175" width="700" height="95" /></mxCell><mxCell id="compare" value="&lt;b&gt;先识别知识及适用条件&lt;/b&gt;&lt;br&gt;提取必要前置知识、讲解步骤、已有规则与条件&lt;br&gt;年级只作辅助；不能仅因“小学 + 一次函数”就判定不理解" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="325" width="700" height="105" /></mxCell><mxCell id="in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="input" target="compare"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d1" value="在相同适用条件下，&lt;br&gt;与画像已有知识或课堂知识&lt;br&gt;存在尚未解决的矛盾？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="490" width="440" height="150" /></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="compare" target="d1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜矛盾待解决&lt;/b&gt;&lt;br&gt;相同适用条件下，新旧说法互相矛盾&lt;br&gt;关联双方 p / k 条目、来源与矛盾说明&lt;br&gt;不自动认定哪方错误，不自动让旧知识失效" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="505" width="470" height="125" /></mxCell><mxCell id="yes1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d2" value="缺少必要前置知识，&lt;br&gt;或讲解跨度超出理解基础，&lt;br&gt;无法建立理解链条？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="740" width="440" height="150" /></mxCell><mxCell id="no1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear｜必要信息或基础缺失&lt;/b&gt;&lt;br&gt;记录具体缺失的前置知识 / 解释步骤&lt;br&gt;如直接使用未学过的变量、坐标或概念&lt;br&gt;关键缺口无法靠现有知识补齐" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="755" width="470" height="125" /></mxCell><mxCell id="yes2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C59B45;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="unclear"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d3" value="教师存在跳步，&lt;br&gt;但凭已有知识与已讲内容&lt;br&gt;能补出中间过程？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="990" width="440" height="150" /></mxCell><mxCell id="no2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative｜可接受的跳步推断&lt;/b&gt;&lt;br&gt;仅用于有跳步但可以补出的情况&lt;br&gt;记录跳过哪一步、凭哪些依据补出&lt;br&gt;推断仍待确认，不是新知识默认状态" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1005" width="470" height="125" /></mxCell><mxCell id="yes3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5D8DCF;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="tentative"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="understood" value="&lt;b&gt;understood｜当前可推断理解&lt;/b&gt;&lt;br&gt;基础足够，讲解链条完整；可直接进入&lt;br&gt;或原有缺口已补齐，并表现出理解&lt;br&gt;仍不代表经验证的稳定掌握" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="1260" width="440" height="140" /></mxCell><mxCell id="no3" value="无待确认跳步；理解链条完整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="understood"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="guard" value="&lt;b&gt;判定保护&lt;/b&gt;&lt;br&gt;若无法指出具体依据，不强行判 understood。&lt;br&gt;回到缺口检查：记录无法确定的必要信息；&lt;br&gt;无法证明能补出跳步时，不使用 tentative。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="995" width="340" height="150" /></mxCell><mxCell id="guardedge" value="检查不足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="guard" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="revoke" value="&lt;b&gt;invalid｜已失效（独立路径）&lt;/b&gt;&lt;br&gt;教师明确撤回 / 纠正某条旧规则，或新规则明确替代旧规则；必须能定位具体旧条目&lt;br&gt;→ 旧条目直接 invalid，无需先经过 conflict&lt;br&gt;→ 保存失效依据与历史；有替代规则时关联新条目&lt;br&gt;→ 新规则重新走主判定流程，不自动 understood" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="490" width="340" height="255" /></mxCell><mxCell id="req" value="&lt;b&gt;每条状态的最小依据&lt;/b&gt;&lt;br&gt;共同：状态原因、来源 ID、适用条件。unclear：缺失基础；tentative：跳步与补步依据；conflict：双方知识及来源、具体矛盾；understood：理解链条或表现；invalid：失效旧条目、纠正来源、有则记录替代条目。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1470" width="1480" height="100" /></mxCell></root></mxGraphModel></diagram><diagram id="recovery" name="02 改良方案：状态解除与知识使用"><mxGraphModel dx="1600" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1550" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;五状态方案｜解除、修订与使用&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · 与第 1 页配套。新证据到来后重新判断；invalid 是明确失效的历史记录，不参加当前知识的理解程度升级。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="unclear" value="&lt;b&gt;unclear&lt;/b&gt;&lt;br&gt;关键基础或信息不足" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="190" width="400" height="95" /></mxCell><mxCell id="tentative" value="&lt;b&gt;tentative&lt;/b&gt;&lt;br&gt;可补出的跳步，推断待确认" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="190" width="400" height="95" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict&lt;/b&gt;&lt;br&gt;尚未解决的矛盾" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="190" width="400" height="95" /></mxCell><mxCell id="uaction" value="&lt;b&gt;教师补齐前置基础或解释&lt;/b&gt;&lt;br&gt;搭桥、降低讲解难度、补充必要定义&lt;br&gt;检查原来的具体缺口是否消除" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="370" width="400" height="125" /></mxCell><mxCell id="taction" value="&lt;b&gt;新增可观察的确认依据&lt;/b&gt;&lt;br&gt;教师补全步骤；学生解释、回答或应用&lt;br&gt;不能只凭“我懂了”就自动升级" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="370" width="400" height="125" /></mxCell><mxCell id="caction" value="&lt;b&gt;教师澄清条件或明确纠正&lt;/b&gt;&lt;br&gt;条件不同：修订适用范围，双方可保留&lt;br&gt;明确纠正：旧条目 invalid&lt;br&gt;保留 / 修订后的规则重新判断" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="370" width="400" height="125" /></mxCell><mxCell id="aunclear" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="unclear" target="uaction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="atentative" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tentative" target="taction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="aconflict" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="caction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="reevaluate" value="&lt;b&gt;重新走第 1 页的状态判定&lt;/b&gt;&lt;br&gt;未解决矛盾 → conflict；关键缺口 → unclear；可补的跳步 → tentative；完整理解 → understood&lt;br&gt;原问题尚存时保留对应状态；新证据也可以使 understood 重新进入其他状态。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="610" width="1120" height="130" /></mxCell><mxCell id="ruaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="uaction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rtaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="taction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rcaction" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitY=1;entryY=0;" edge="1" parent="1" source="caction" target="reevaluate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="profile" value="&lt;b&gt;画像前置知识 p 的冲突处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 关联画像中的具体前置知识 ID，记录双方来源和条件。&lt;br&gt;2. 发现可识别的同条件矛盾 → conflict，等待澄清。&lt;br&gt;3. 条件不同 → 修订范围；教师明确纠正 → 旧前置知识 invalid，修订后的当前规则重新判定。&lt;br&gt;4. 保存原始画像与历史；后续上下文使用修订后的基础，避免旧设定反复制造同一冲突。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="820" width="690" height="260" /></mxCell><mxCell id="historical" value="&lt;b&gt;冲突与失效拆为两个状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;conflict：&lt;/b&gt;双方说法矛盾，尚未解决。&lt;br&gt;必须关联双方知识、各自来源与适用条件。&lt;br&gt;澄清条件后，双方可能都保留。&lt;br&gt;&lt;br&gt;&lt;b&gt;invalid：&lt;/b&gt;旧规则被明确撤回、纠正或替代。&lt;br&gt;必须关联旧条目与教师纠正来源；有替代规则时关联新条目。保留历史，停止使用。&lt;br&gt;&lt;br&gt;发现矛盾不等于已有规则失效。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="820" width="690" height="260" /></mxCell><mxCell id="useu" value="&lt;b&gt;understood 的使用&lt;/b&gt;&lt;br&gt;进入当前有效知识，可用于后续推理。&lt;br&gt;遇到新证据仍可重新判断。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1170" width="350" height="145" /></mxCell><mxCell id="uset" value="&lt;b&gt;tentative 的使用&lt;/b&gt;&lt;br&gt;保留不确定标记，有条件参与推理。&lt;br&gt;后续推断继承未确认前提；不能把它&lt;br&gt;无条件当成确定事实传播。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1170" width="350" height="145" /></mxCell><mxCell id="usei" value="&lt;b&gt;unclear / conflict 的使用&lt;/b&gt;&lt;br&gt;保留为理解障碍与待澄清内容。&lt;br&gt;不作为确定事实使用。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF5DF;strokeColor=#D9B15C;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1170" width="350" height="145" /></mxCell><mxCell id="question" value="&lt;b&gt;与问题生命周期的关系&lt;/b&gt;&lt;br&gt;缺口或矛盾可以生成关联问题，但问题 resolved 不直接等于知识 understood。&lt;br&gt;教师解释到来后，知识状态独立重新判定；不依赖是否实际发出提问。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1360" width="1460" height="115" /></mxCell><mxCell id="useinvalid" value="&lt;b&gt;invalid 的使用&lt;/b&gt;&lt;br&gt;停止用于后续推理。&lt;br&gt;只保留历史及失效依据。&lt;br&gt;重新采用时创建新版本并重新判定，不静默复活旧条目。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="1170" width="350" height="145" /></mxCell></root></mxGraphModel></diagram><diagram id="conflict-invalid" name="03 conflict 与 invalid：条件、关联与转换"><mxGraphModel dx="1600" dy="1610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1610" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:30px&quot;&gt;conflict ↔ invalid｜判断条件与关联关系&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="25" width="1500" height="55" /></mxCell><mxCell id="subtitle" value="拟议方案 · 2026-10-14 · conflict 表示知识之间的待解决矛盾；invalid 表示某一旧条目已经失效。&lt;br&gt;教师讲错但学生无法发现时，按当时依据判理解状态；不能借助事后纠正倒推当时应为 conflict。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;text;strokeColor=none;fillColor=none;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="65" /></mxCell><mxCell id="new" value="&lt;b&gt;教师新增说法 / 纠正说明&lt;/b&gt;&lt;br&gt;结合学生可获得的已有知识与来源判断" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EDF4FF;strokeColor=#91B5EA;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="170" width="600" height="90" /></mxCell><mxCell id="explicit" value="教师明确撤回、纠正或替代，&lt;br&gt;且能定位具体旧条目？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="325" width="500" height="150" /></mxCell><mxCell id="ne" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="new" target="explicit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="invalid" value="&lt;b&gt;旧条目 → invalid｜已失效&lt;/b&gt;&lt;br&gt;关联：旧知识 ID、教师纠正来源&lt;br&gt;有新规则时记录替代知识 ID&lt;br&gt;明确失效，不代表已证明在所有条件下错误" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="340" width="430" height="145" /></mxCell><mxCell id="ei" value="是：直接失效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="explicit" target="invalid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="contradiction" value="学生凭已有内容能识别：&lt;br&gt;同一适用条件下，&lt;br&gt;双方说法互相矛盾？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="575" width="500" height="150" /></mxCell><mxCell id="ec" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="explicit" target="contradiction"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conflict" value="&lt;b&gt;conflict｜矛盾待解决&lt;/b&gt;&lt;br&gt;关联：双方 p / k 条目、各自来源&lt;br&gt;记录：适用条件与具体矛盾&lt;br&gt;暂不认定哪方错误；后说的也不自动优先" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="590" width="430" height="145" /></mxCell><mxCell id="cc" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#BD786F;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="contradiction" target="conflict"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="normal" value="&lt;b&gt;按当前理解条件判断&lt;/b&gt;&lt;br&gt;关键基础缺失 → unclear&lt;br&gt;可接受且可补出的跳步 → tentative&lt;br&gt;理解链条完整 → understood&lt;br&gt;未知事实错误不会被模型用外部知识自动识别" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="590" width="400" height="160" /></mxCell><mxCell id="cn" value="否 / 无发现依据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="contradiction" target="normal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="clarify" value="&lt;b&gt;教师后续澄清&lt;/b&gt;&lt;br&gt;尚未澄清：保持 conflict&lt;br&gt;普通补充或重复讲解不能触发 invalid" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="820" width="430" height="110" /></mxCell><mxCell id="cq" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conflict" target="clarify"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="branch" value="后续说明解决了什么？" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="1000" width="430" height="120" /></mxCell><mxCell id="qb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clarify" target="branch"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="conditions" value="&lt;b&gt;适用条件不同&lt;/b&gt;&lt;br&gt;修订范围，双方都可能保留&lt;br&gt;相关当前条目重新判定&lt;br&gt;不能仅因扩展范围就让旧规则失效" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#EAF7F0;strokeColor=#88C7A5;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="1190" width="430" height="145" /></mxCell><mxCell id="bc" value="澄清条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="branch" target="conditions"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="corrected" value="&lt;b&gt;明确纠正其中一条&lt;/b&gt;&lt;br&gt;被纠正旧条目 → invalid&lt;br&gt;其余保留 / 修订规则重新判定&lt;br&gt;新规则不自动 understood" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#FFF0EE;strokeColor=#D99087;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="1190" width="430" height="145" /></mxCell><mxCell id="br" value="明确纠正" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="branch" target="corrected"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="replacement" value="&lt;b&gt;直接失效后的处理&lt;/b&gt;&lt;br&gt;有替代规则 → 回到第 1 页重新判定&lt;br&gt;只有撤回 → 不猜测替代规则&lt;br&gt;保留旧状态历史与失效来源" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="340" width="400" height="145" /></mxCell><mxCell id="ir" value="处理替代规则" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7890AB;fontSize=14;fontColor=#41556D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="invalid" target="replacement"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="history" value="&lt;b&gt;历史记录示例&lt;/b&gt;&lt;br&gt;教师错误讲授，学生当时理解 → understood；后来教师明确改正 → 旧条目 invalid。&lt;br&gt;保留“当时 understood，后来 invalid”的时间过程。&lt;br&gt;仅有新说法、普通补充或重复讲解，不构成明确失效。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#24344B;align=center;verticalAlign=middle;spacing=14;fillColor=#F3F5F8;strokeColor=#BBC5D3;strokeWidth=1.5;rounded=1;arcSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1410" width="1460" height="130" /></mxCell></root></mxGraphModel></diagram></mxfile>