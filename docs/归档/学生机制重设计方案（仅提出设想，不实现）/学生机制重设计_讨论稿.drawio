        <mxCell id="edge-5" value="能" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#6AAA93;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="detect" target="gap">
