        <mxCell id="title" value="02  课堂主循环：组织小工作区，缺材料再回查" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="32" width="1480" height="48" as="geometry" />
        </mxCell>
