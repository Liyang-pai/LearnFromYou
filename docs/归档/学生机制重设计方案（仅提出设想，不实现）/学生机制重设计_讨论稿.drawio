  </diagram>
  <diagram id="lfy-redesign-6" name="06 验证方案：用真实行为和总成本检验重设计">
    <mxGraphModel dx="1600" dy="1340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1340" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="06  验证方案：用真实行为和总成本检验重设计" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="32" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="先与极简基线做课堂对照，再决定哪些机制值得实现；本页为验证计划，尚未执行新模型测试。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#526176;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 学生机制重设计 · 2026-11-07  |  讨论草案，尚未实现 / 尚未回放验证  |  06 / 06" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#64748B;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1286" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lesson1" value="&lt;b&gt;已有教训：图片接触被当作理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;广义表定义展示后即登记 understood&lt;br&gt;后续实际发言说明自己在照图复述&lt;br&gt;需分开接触、复述与独立使用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="465" height="155" as="geometry" />
        </mxCell>
        <mxCell id="lesson2" value="&lt;b&gt;已有教训：同标签掩盖不同卡点&lt;/b&gt;&lt;br&gt;&lt;br&gt;理解困难对照：两组标签同为 tentative&lt;br&gt;一组解释公式含义，另一组卡在计数意义&lt;br&gt;表现证据比总标签更具体" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="565" y="165" width="465" height="155" as="geometry" />
        </mxCell>
        <mxCell id="lesson3" value="&lt;b&gt;已有教训：长课输入持续增长&lt;/b&gt;&lt;br&gt;&lt;br&gt;47 轮首次学生请求：8,345 → 22,647 token&lt;br&gt;末轮仍携带 25 条已回答请求&lt;br&gt;53 次学生请求中包含 6 次校验重试" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1075" y="165" width="465" height="155" as="geometry" />
        </mxCell>
        <mxCell id="fixtures" value="&lt;b&gt;固定课堂材料与一致条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一画像 / 模型配置 / 输入顺序 / 提示条件&lt;br&gt;区分模型候选、取消结果与实际送达" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="baseline" value="&lt;b&gt;极简基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;短能力边界＋有限课堂上下文&lt;br&gt;最少管理规则，作为比较起点&lt;br&gt;不预设它比现方案或新方案更好" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="180" y="555" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="proposal" value="&lt;b&gt;重设计方案&lt;/b&gt;&lt;br&gt;&lt;br&gt;话题理解笔记＋任务相关材料回查&lt;br&gt;实际表现留证＋局部纠错重建&lt;br&gt;将全部新增调用与修复纳入成本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="555" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cases" value="&lt;b&gt;优先使用现有课堂案例&lt;/b&gt;&lt;br&gt;&lt;br&gt;看图复述 → 换一个新例子&lt;br&gt;只给公式 → 要求解释意义&lt;br&gt;补讲之后 → 独立题与迁移&lt;br&gt;撤回规则之后 → 再次应用&lt;br&gt;无关内容插入之后 → 回到旧话题&lt;br&gt;换表格讲懂 → 保留原图像卡点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="behavior" value="&lt;b&gt;核对实际课堂行为&lt;/b&gt;&lt;br&gt;&lt;br&gt;补讲是否改善了具体表现？&lt;br&gt;纠正后是否停用受影响的旧规则？&lt;br&gt;跨话题是否能找回有效材料？&lt;br&gt;多路径理解是否保留适用范围？&lt;br&gt;没有证据时报告是否保留未知？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="790" width="520" height="225" as="geometry" />
        </mxCell>
        <mxCell id="cost" value="&lt;b&gt;核对整轮成本与可用性&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入 / 输出 token；缓存命中与未命中&lt;br&gt;检索、摘要、修复等全部调用费用&lt;br&gt;端到端等待时间；重试与送达情况&lt;br&gt;普通轮次输入是否避免随全课不断复制&lt;br&gt;不以知识标签通过数代替行为效果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1140" y="790" width="400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;行为质量保住或改善，&#10;且总成本降低？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="645" y="1080" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="iterate" value="&lt;b&gt;定位失败，删改无效机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;调整后重新进行相同条件对照&lt;br&gt;材料选择漏项 / 越界 / 纠错漏关联重点查" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#D99BA4;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="implement" value="&lt;b&gt;再考虑小范围实现&lt;/b&gt;&lt;br&gt;&lt;br&gt;保留有效机制，再扩大课堂长度和题材&lt;br&gt;不凭缩短 Prompt 承诺行为可靠或节省比例" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
