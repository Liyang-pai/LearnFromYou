        <mxCell id="student-lane" value="学生模型：当前意图与理解" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
