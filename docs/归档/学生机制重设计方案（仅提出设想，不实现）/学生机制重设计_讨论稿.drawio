  <diagram id="lfy-redesign-1" name="01 整体架构：学生理解与课堂证据分开">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="01  整体架构：学生理解与课堂证据分开" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="32" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="目标：有能力边界的学生持续参与课堂；完整记录留在后台，普通轮次只读取相关材料。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#526176;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 学生机制重设计 · 2026-11-07  |  讨论草案，尚未实现 / 尚未回放验证  |  01 / 06" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#64748B;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1096" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="灰：课堂资料    蓝：课堂处理    绿：学生理解    黄：表现证据    紫：程序控制" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;课前确认的能力边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;可独立完成的前置操作&lt;br&gt;需要怎样的提示；哪些目标尚未学习" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;学生当前理解 · 按话题保存&lt;/b&gt;&lt;br&gt;&lt;br&gt;我目前怎样理解；能回应到哪里&lt;br&gt;具体卡点；必要条件与材料引用&lt;br&gt;简短、可修订，允许形成错误理解" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="&lt;b&gt;设计取舍&lt;/b&gt;&lt;br&gt;&lt;br&gt;取消逐条知识的五状态主线&lt;br&gt;取消完整依赖图和全课连锁复核&lt;br&gt;保留能力边界、条件、纠正与卡点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="200" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;老师的新输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;讲解 / 提问 / 图片 / 条件澄清 / 纠正&lt;br&gt;原话与图片绑定，先写入课堂档案" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="&lt;b&gt;组织本轮工作区&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前任务＋相关理解＋必要原文 / 图片&lt;br&gt;当前有效纠正＋正在处理的疑问&lt;br&gt;回查已讲内容；完成事项退出工作区" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="student" value="&lt;b&gt;学生处理当前课堂&lt;/b&gt;&lt;br&gt;&lt;br&gt;理解讲解、回答、提问或静默&lt;br&gt;提出局部理解变化及材料引用&lt;br&gt;内部理解估计与实际能力证据分开" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="420" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="archive" value="&lt;b&gt;完整课堂档案&lt;/b&gt;&lt;br&gt;&lt;br&gt;原始讲授、图片、纠正、历史修订&lt;br&gt;实际送达与未送达候选分别保存&lt;br&gt;按需回查，不作为每轮全量输入" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="340" height="155" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;实际表现证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;题目与条件；提示程度；实际回答&lt;br&gt;引用的课堂材料；可用的评价依据&lt;br&gt;有参考答案或人工核对才支持正确性判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="660" width="430" height="155" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;程序校验与发言控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;格式 / 来源检查；静音与输入过期检查&lt;br&gt;记录实际送达；管理重复、取消与重试&lt;br&gt;编号、版本和次数由程序维护" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="660" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;课堂回顾 / 教学评价&lt;/b&gt;&lt;br&gt;&lt;br&gt;基于原始课堂与实际表现组织报告；未知处保留“尚未观察到”。&lt;br&gt;教学正确性可独立评估；评价答案不回灌给学生。认知、问题与修订可从记录展示。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="930" width="1040" height="115" as="geometry" />
        </mxCell>
        <mxCell id="principle" value="&lt;b&gt;核心原则&lt;/b&gt;&lt;br&gt;&lt;br&gt;档案完整保存&lt;br&gt;当下只读真正需要的部分" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="340" height="115" as="geometry" />
