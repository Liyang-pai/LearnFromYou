        </mxCell>
        <mxCell id="input" value="&lt;b&gt;接收老师的新讲解 / 当前任务&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="575" y="170" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="prior" value="&lt;b&gt;稳定背景＋当前理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;简短的能力边界&lt;br&gt;相关话题的理解笔记&lt;br&gt;最近必要的真实问答与活跃卡点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="400" height="165" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="&lt;b&gt;准备本轮工作区&lt;/b&gt;&lt;br&gt;&lt;br&gt;新讲解 / 任务＋相关学生理解&lt;br&gt;必要的教师原文与图片&lt;br&gt;相关有效纠正＋活跃请求 / 疑问" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="575" y="325" width="450" height="155" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;后台材料库＋简短话题索引&lt;/b&gt;&lt;br&gt;&lt;br&gt;课堂原文、图片和纠正覆盖关系&lt;br&gt;历史理解、已完成请求、已解决疑问&lt;br&gt;按话题 / 提及内容 / 当前卡点取材" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="325" width="405" height="155" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;工作区预算&lt;/b&gt;&lt;br&gt;&lt;br&gt;按当前任务规模控制输入&lt;br&gt;同一原文只提供一次&lt;br&gt;超限时重选材料或回查&lt;br&gt;保住关键条件、纠正与未解决卡点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="process" value="&lt;b&gt;学生处理本轮材料&lt;/b&gt;&lt;br&gt;&lt;br&gt;判断能理解到哪里、能否回应&lt;br&gt;有依据时可以补合理步骤；不补未教领域规则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="575" y="565" width="450" height="115" as="geometry" />
        </mxCell>
        <mxCell id="enough" value="&lt;b&gt;回应所需材料&#10;是否足够？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="685" y="740" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;限次回查已讲过的内容&lt;/b&gt;&lt;br&gt;&lt;br&gt;区分“没学过”和“材料未载入”&lt;br&gt;回查原文 / 图片及相关纠正" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="715" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="found" value="&lt;b&gt;是否找到&#10;有效依据？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="140" y="915" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;提出一个反应＋局部理解变化&lt;/b&gt;&lt;br&gt;&lt;br&gt;静默 / 回答 / 提问；简短来源引用&lt;br&gt;仍缺依据时说明卡点，保留不确定部分" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="575" y="935" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;程序校验、提交理解并处理发言&lt;/b&gt;&lt;br&gt;&lt;br&gt;候选是否送达单独结算；进入下一轮" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="575" y="1120" width="450" height="85" as="geometry" />
        </mxCell>
        <mxCell id="global" value="&lt;b&gt;全课任务使用单独选材方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;“总结整节课”等任务扩大覆盖范围&lt;br&gt;按全课话题索引组织材料&lt;br&gt;额外摘要 / 检索也计入费用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="605" width="405" height="145" as="geometry" />
        </mxCell>
        <mxCell id="retire" value="&lt;b&gt;完成事项退出工作区&lt;/b&gt;&lt;br&gt;&lt;br&gt;已回答请求、已解决疑问留在档案&lt;br&gt;不因历史中有引用就永久携带原文&lt;br&gt;学生发言不自动成为新的领域知识" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
