        <mxCell id="program-lane" value="程序：校验、时机与结算" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
          <mxGeometry x="585" y="155" width="430" height="900" as="geometry" />
        </mxCell>
        <mxCell id="delivery-lane" value="实际结果：送达与未送达分开" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
          <mxGeometry x="1110" y="155" width="430" height="900" as="geometry" />
        </mxCell>
        <mxCell id="proposal" value="&lt;b&gt;提出一个课堂反应&lt;/b&gt;&lt;br&gt;&lt;br&gt;静默 / 回答 / 提问&lt;br&gt;可指出目标请求、当前卡点和来源" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="235" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;候选暂存＋格式 / 来源校验&lt;/b&gt;&lt;br&gt;&lt;br&gt;无效输出走有限修复&lt;br&gt;编号、输入版本、次数由程序维护" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="235" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;当前允许发言？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="685" y="435" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="&lt;b&gt;候选暂存 / 取消 / 静默&lt;/b&gt;&lt;br&gt;&lt;br&gt;静音、输入过期、时机未到等&lt;br&gt;不算已回答，不增加实际提问次数&lt;br&gt;保留原因，必要时支持恢复 / 重试" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="420" width="380" height="155" as="geometry" />
        </mxCell>
        <mxCell id="send" value="&lt;b&gt;发出课堂回复&lt;/b&gt;&lt;br&gt;&lt;br&gt;发出后记录结果；失败可恢复 / 重试&lt;br&gt;仅候选生成成功不代表实际送达" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="635" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="delivered" value="&lt;b&gt;记录实际送达&lt;/b&gt;&lt;br&gt;&lt;br&gt;回答正文、时间、对应请求 / 卡点&lt;br&gt;相关题目与课堂材料" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="635" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="settle" value="&lt;b&gt;按实际送达结算&lt;/b&gt;&lt;br&gt;&lt;br&gt;请求改为已回应；记录真实提问次数&lt;br&gt;形成实际问答历史与表现证据&lt;br&gt;完成请求退出下轮工作区" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="865" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="active" value="&lt;b&gt;保留少量活跃对话事项&lt;/b&gt;&lt;br&gt;&lt;br&gt;正在等回应的请求；尚未解决的疑问&lt;br&gt;老师说稍后解释的疑问继续等待&lt;br&gt;相关新讲解到来后检查原卡点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="865" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="semantic" value="&lt;b&gt;模型主要判断&lt;/b&gt;&lt;br&gt;&lt;br&gt;老师当前在做什么？&lt;br&gt;我能回应到哪里？&lt;br&gt;具体哪里接不上？&lt;br&gt;理解有什么局部变化？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="445" width="380" height="215" as="geometry" />
        </mxCell>
        <mxCell id="program" value="&lt;b&gt;程序主要负责&lt;/b&gt;&lt;br&gt;&lt;br&gt;静音 / 输入过期 / 发言时机&lt;br&gt;重复提问控制及取消 / 重试&lt;br&gt;明确邀请时允许重新说明原疑问&lt;br&gt;计数以实际送达为准&lt;br&gt;同一疑问沿用身份，不靠换编号重问" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="755" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#7CA6D8;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="proposal" target="candidate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#A99ACA;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="candidate" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#A99ACA;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="gate" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#94A3B8;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="gate" target="cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="实际送达成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#D3B46D;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="send" target="delivered">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#D3B46D;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="delivered" target="settle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="更新活跃事项" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#A99ACA;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="settle" target="active">
