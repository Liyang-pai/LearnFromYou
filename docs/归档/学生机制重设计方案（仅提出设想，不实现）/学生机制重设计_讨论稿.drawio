  <diagram id="lfy-redesign-3" name="03 知识处理：理解可以变化，能力结论要有证据">
    <mxGraphModel dx="1600" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1210" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03  知识处理：理解可以变化，能力结论要有证据" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="32" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="学生内部理解用于驱动下一次反应；任务表现用于支持课堂回顾中的能力描述。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#526176;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 学生机制重设计 · 2026-11-07  |  讨论草案，尚未实现 / 尚未回放验证  |  03 / 06" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#64748B;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1156" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lane-source" value="课堂材料 / 能力边界" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="430" height="900" as="geometry" />
        </mxCell>
        <mxCell id="lane-memory" value="学生当前理解" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
          <mxGeometry x="585" y="155" width="430" height="900" as="geometry" />
        </mxCell>
        <mxCell id="lane-evidence" value="实际任务表现" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#526176;" vertex="1" parent="1">
          <mxGeometry x="1110" y="155" width="430" height="900" as="geometry" />
        </mxCell>
        <mxCell id="teach" value="&lt;b&gt;老师讲解 / 图片给出定义&lt;/b&gt;&lt;br&gt;&lt;br&gt;材料已经展示，只证明接触过&lt;br&gt;保留原文、图片与适用条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="240" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="understand" value="&lt;b&gt;依据当前基础形成局部理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;听懂解释可以更新理解&lt;br&gt;已有基础足够时允许合理推导&lt;br&gt;变化仍是可修订的内部估计" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="task" value="&lt;b&gt;老师提出具体任务&lt;/b&gt;&lt;br&gt;&lt;br&gt;题目、条件、是否提供例子 / 提示&lt;br&gt;自然发生时记录，无需每步强制考试" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="240" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ability" value="&lt;b&gt;画像写成可观察的能力边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;哪些前置操作可独立完成&lt;br&gt;哪些联系需要例子或分步提示&lt;br&gt;新解释到来后允许改变局部限制&lt;br&gt;不设置随机犯错概率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="455" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;理解笔记示例：表尾&lt;/b&gt;&lt;br&gt;&lt;br&gt;定义已听过，可对照例子复述。&lt;br&gt;新例子的独立取表尾尚未观察。&lt;br&gt;当前卡点：括号层级怎样保留？&lt;br&gt;保留相关材料引用与适用范围。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="455" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="&lt;b&gt;按当前理解回应任务&lt;/b&gt;&lt;br&gt;&lt;br&gt;能回答到哪一步；哪里需要帮助&lt;br&gt;保留实际发出的回答与提示条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="455" width="380" height="145" as="geometry" />
        </mxCell>
        <mxCell id="belief" value="&lt;b&gt;允许符合学生边界的错误理解&lt;/b&gt;&lt;br&gt;&lt;br&gt;老师讲错而学生发现不了时&lt;br&gt;学生可能接受错误说法&lt;br&gt;课后评价不提前把正确答案交给学生" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="745" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;同一点可以有不同表现&lt;/b&gt;&lt;br&gt;&lt;br&gt;会代入，但解释意义仍卡住&lt;br&gt;会做原例，迁移尚未观察&lt;br&gt;“我懂了”不能单独证明独立应用&lt;br&gt;未送达候选不计为实际表现" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="745" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;保存任务证据，限定结论范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;原题与条件＋提示程度＋实际回答&lt;br&gt;可区分：复述、解释、独立做题、迁移&lt;br&gt;这些是具体记录，不是新的总状态枚举&lt;br&gt;缺少参考答案 / 人工核对时保留待评价" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1135" y="705" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;报告根据实际证据描述：在什么条件下，完成过什么；未观察到的能力保留未知。&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="1080" width="1430" height="65" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#7CA6D8;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="teach" target="understand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
