  <diagram id="lfy-redesign-4" name="04 纠错与条件澄清：使用前检查，按话题局部重建">
    <mxGraphModel dx="1600" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1320" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04  纠错与条件澄清：使用前检查，按话题局部重建" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="32" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="保留纠正及作用范围；相关理解需要重建时限制旧结论使用，不启动全课依赖传播。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#526176;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="LearnFromYou · 学生机制重设计 · 2026-11-07  |  讨论草案，尚未实现 / 尚未回放验证  |  04 / 06" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#64748B;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1266" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;老师提出新说法 / 条件澄清 / 纠正&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="175" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="explicit" value="&lt;b&gt;是否明确撤回或&#10;替代可定位的旧说法？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="325" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="different" value="&lt;b&gt;保留原话与双方适用条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅有不同说法不自动覆盖旧说法&lt;br&gt;“先不学 / 换个讲法”按课堂安排处理&lt;br&gt;条件不同的规则可以并存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="410" height="155" as="geometry" />
        </mxCell>
        <mxCell id="detect" value="&lt;b&gt;学生凭已有材料&#10;能识别同条件矛盾？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="145" y="585" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;能识别：记录具体冲突卡点&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前推理保留不确定性&lt;br&gt;合适时机请老师澄清&lt;br&gt;条件澄清后分别更新适用范围" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="825" width="410" height="140" as="geometry" />
        </mxCell>
        <mxCell id="unnoticed" value="&lt;b&gt;不能识别：按实际理解能力继续&lt;/b&gt;&lt;br&gt;&lt;br&gt;不借用外部常识替学生裁决&lt;br&gt;允许学生形成错误理解&lt;br&gt;后续教学仍可修正" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="825" width="410" height="140" as="geometry" />
        </mxCell>
        <mxCell id="correction" value="&lt;b&gt;记录纠正、范围与覆盖关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;定位旧说法、老师的明确纠正原文&lt;br&gt;保留新规则；没给新规则时不猜补" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="345" width="430" height="155" as="geometry" />
        </mxCell>
        <mxCell id="stale" value="&lt;b&gt;标记相关话题的旧理解待重建&lt;/b&gt;&lt;br&gt;&lt;br&gt;使用前停用受影响的旧结论&lt;br&gt;未受影响的话题与独立理解保留&lt;br&gt;更正前的任务表现留在历史" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A99ACA;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="585" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rebuild" value="&lt;b&gt;再次使用时局部重建&lt;/b&gt;&lt;br&gt;&lt;br&gt;取必要原文＋新纠正，重写局部理解&lt;br&gt;恢复有依据部分，保留新卡点&lt;br&gt;无需逐条知识版本图与后台连锁复核" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6AAA93;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="825" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="use-check" value="&lt;b&gt;同话题与跨话题调用都检查更正&lt;/b&gt;&lt;br&gt;&lt;br&gt;回查材料时同时带入相关纠正记录&lt;br&gt;相关理解未重建前，不用旧规则给确定答案&lt;br&gt;范围不清楚时保守处理，并保留澄清需要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="545" y="565" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="continue" value="&lt;b&gt;继续当前 / 后续任务&lt;/b&gt;&lt;br&gt;&lt;br&gt;按新的局部理解回应；尚不确定部分继续保留" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#7CA6D8;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="1090" width="495" height="90" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;历史表现保留上下文&lt;/b&gt;&lt;br&gt;&lt;br&gt;注明使用更正前的资料&lt;br&gt;不直接证明新规则下的能力" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D3B46D;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tradeoff" value="&lt;b&gt;需要验证的取舍&lt;/b&gt;&lt;br&gt;&lt;br&gt;重建较粗，牺牲局部更新精细度&lt;br&gt;重点检查跨话题纠正是否漏关联" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#243247;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacingLeft=19;spacingRight=17;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1080" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#7CA6D8;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="input" target="explicit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#94A3B8;strokeWidth=1.7;endArrow=block;endFill=1;fontColor=#475569;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="explicit" target="different">
