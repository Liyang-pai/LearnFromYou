# Copy this file to .env. Never commit your actual key.
DEEPSEEK_API_KEY=replace_with_your_key
# The legacy Deepseek_API name also works, but new installations should use
# DEEPSEEK_API_KEY.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Download and select ASR models in the web UI. All files stay in asr/models/.
ASR_THREADS=2
TTS_VOICE=Tingting
PORT=8765
SEGMENT_PAUSE=3
LONG_SEGMENT_PAUSE=1
SEGMENT_MAX_WAIT=20
SPEAK_PAUSE=5
DIRECT_PAUSE=1
